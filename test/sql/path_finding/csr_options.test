# name: test/sql/path_finding/csr_options.test
# description: Test experimental CSR lifecycle settings
# group: [path_finding]

require duckpgq

# CSR lifecycle behavior is opt-in.
query II
SELECT CAST(current_setting('experimental_persist_csr') AS BOOLEAN)::INTEGER,
       CAST(current_setting('experimental_build_csr_on_create') AS BOOLEAN)::INTEGER;
----
0	0

# The lifecycle options are independent. Persistence does not imply eager construction.
statement ok
SET experimental_persist_csr = true;

query II
SELECT CAST(current_setting('experimental_persist_csr') AS BOOLEAN)::INTEGER,
       CAST(current_setting('experimental_build_csr_on_create') AS BOOLEAN)::INTEGER;
----
1	0

statement ok
SET experimental_build_csr_on_create = true;

query II
SELECT CAST(current_setting('experimental_persist_csr') AS BOOLEAN)::INTEGER,
       CAST(current_setting('experimental_build_csr_on_create') AS BOOLEAN)::INTEGER;
----
1	1

statement ok
SET experimental_persist_csr = false;

query II
SELECT CAST(current_setting('experimental_persist_csr') AS BOOLEAN)::INTEGER,
       CAST(current_setting('experimental_build_csr_on_create') AS BOOLEAN)::INTEGER;
----
0	1

statement ok
SET experimental_persist_csr = true;

statement ok
SET threads = 8;

# The eager builder must override these for its nested self-pair traversal.
statement ok
SET experimental_path_finding_operator_grouped_batches = false;

statement ok
SET experimental_path_finding_operator_threads_per_batch = 0;

statement ok
SET experimental_path_finding_operator_benchmark = true;

statement ok
SET experimental_path_finding_operator_benchmark_prefix = '{TEST_DIR}/csr_options_eager';

query II
SELECT CAST(current_setting('experimental_persist_csr') AS BOOLEAN)::INTEGER,
       CAST(current_setting('experimental_build_csr_on_create') AS BOOLEAN)::INTEGER;
----
1	1

statement ok
SET experimental_path_finding_operator_light_partition_multiplier = 2;

statement ok con2
SET experimental_path_finding_operator = true;

statement ok con2
SET experimental_path_finding_operator_light_partition_multiplier = 2;

statement ok con2
SELECT delete_csr(2147483647);

statement ok
CREATE TABLE eager_vertex(id BIGINT);

statement ok
INSERT INTO eager_vertex VALUES (1), (2), (3), (4);

statement ok
CREATE TABLE eager_edge(src BIGINT, dst BIGINT);

statement ok
INSERT INTO eager_edge VALUES (1, 2), (2, 3), (3, 4);

statement ok
CREATE TABLE eager_edge_reverse(src BIGINT, dst BIGINT);

statement ok
INSERT INTO eager_edge_reverse VALUES (4, 3), (3, 2), (2, 1);

statement ok
CREATE TABLE eager_other_vertex(id BIGINT);

statement ok
INSERT INTO eager_other_vertex VALUES (10), (20);

statement ok
CREATE TABLE eager_cross_edge(src BIGINT, dst BIGINT);

statement ok
INSERT INTO eager_cross_edge VALUES (1, 10), (2, 20);

statement ok
CREATE TABLE eager_empty_edge(src BIGINT, dst BIGINT);

statement ok
CREATE PROPERTY GRAPH eager_graph
VERTEX TABLES (
    eager_vertex LABEL Vertex,
    eager_other_vertex LABEL OtherVertex
)
EDGE TABLES (
    eager_edge SOURCE KEY (src) REFERENCES eager_vertex(id)
               DESTINATION KEY (dst) REFERENCES eager_vertex(id)
               LABEL Edge,
    eager_edge_reverse SOURCE KEY (src) REFERENCES eager_vertex(id)
                       DESTINATION KEY (dst) REFERENCES eager_vertex(id)
                       LABEL ReverseEdge,
    eager_cross_edge SOURCE KEY (src) REFERENCES eager_vertex(id)
                     DESTINATION KEY (dst) REFERENCES eager_other_vertex(id)
                     LABEL CrossEdge,
    eager_empty_edge SOURCE KEY (src) REFERENCES eager_vertex(id)
                     DESTINATION KEY (dst) REFERENCES eager_vertex(id)
                     LABEL EmptyEdge
);

# Only the trivial self-pair BFS is single-threaded; CSR construction retains the configured thread count.
query I
SELECT count(*)
FROM read_csv_auto('{TEST_DIR}/csr_options_eager_phase_timing.csv')
WHERE Phase = 'bfs_batch_grouped'
  AND ThreadCount = 1;
----
3

query I
SELECT count(*)
FROM read_csv_auto('{TEST_DIR}/csr_options_eager_phase_timing.csv')
WHERE Phase = 'local_csr_forward'
  AND ThreadCount = 8;
----
3

# Eager persistence exposes distinct lookup, load attempt, rebuild, and durable-write phases for every eligible edge.
query TI rowsort
SELECT Phase, count(*)
FROM read_csv_auto('{TEST_DIR}/csr_options_eager_phase_timing.csv')
WHERE Phase IN (
    'partitioned_csr_metadata_lookup',
    'partitioned_csr_deserialize_load',
    'partitioned_csr_rebuild',
    'partitioned_csr_serialize_write'
)
GROUP BY Phase;
----
partitioned_csr_deserialize_load	3
partitioned_csr_metadata_lookup	3
partitioned_csr_rebuild	3
partitioned_csr_serialize_write	3

statement ok
SET experimental_path_finding_operator = true;

# A cache-only marker would fail if CREATE PROPERTY GRAPH had not published the CSR.
query I
SELECT iterativelengthoperator(
    src, dst, 4::BIGINT, 3::BIGINT,
    'eager_graph|eager_edge|directed'
)
FROM (SELECT 0::BIGINT AS src, 3::BIGINT AS dst);
----
3

query I
SELECT iterativelengthoperator(
    src, dst, 4::BIGINT, 0::BIGINT,
    'eager_graph|eager_empty_edge|directed'
)
FROM (SELECT 0::BIGINT AS src, 0::BIGINT AS dst);
----
0

# Heterogeneous edge tables are not eligible for the row-ID CSR and are skipped.
statement error
SELECT iterativelengthoperator(
    src, dst, 4::BIGINT, 2::BIGINT,
    'eager_graph|eager_cross_edge|directed'
)
FROM (SELECT 0::BIGINT AS src, 1::BIGINT AS dst);
----
Constraint Error: Cached PartitionCSR not found for cache key 'eager_graph|eager_cross_edge|directed'; build it before using the cache-only path

query I
SELECT iterativelengthoperator(
    src, dst, 4::BIGINT, 3::BIGINT,
    'eager_graph|eager_edge_reverse|directed'
)
FROM (SELECT 3::BIGINT AS src, 0::BIGINT AS dst);
----
3

# Existing connections with matching construction settings receive the immutable index.
query I con2
SELECT iterativelengthoperator(
    src, dst, 4::BIGINT, 3::BIGINT,
    'eager_graph|eager_edge|directed'
)
FROM (SELECT 0::BIGINT AS src, 3::BIGINT AS dst);
----
3

# Logical CSR identity is independent of the query thread count (8-thread build, 1-thread reuse).
statement ok
SET threads = 1;

query I
SELECT iterativelengthoperator(
    src, dst, 4::BIGINT, 3::BIGINT,
    'eager_graph|eager_edge|directed'
)
FROM (SELECT 0::BIGINT AS src, 3::BIGINT AS dst);
----
3

# Build a separate artifact with one thread, then consume it with eight threads.
statement ok
CREATE PROPERTY GRAPH eager_graph_single_thread
VERTEX TABLES (eager_vertex LABEL Vertex)
EDGE TABLES (
    eager_edge SOURCE KEY (src) REFERENCES eager_vertex(id)
               DESTINATION KEY (dst) REFERENCES eager_vertex(id)
               LABEL Edge
);

statement ok
SET threads = 8;

query I
SELECT iterativelengthoperator(
    src, dst, 4::BIGINT, 3::BIGINT,
    'eager_graph_single_thread|eager_edge|directed'
)
FROM (SELECT 0::BIGINT AS src, 3::BIGINT AS dst);
----
3

# Persist-enabled builds use the same canonical physical partition count at one and eight threads.
query I
SELECT count(DISTINCT PartitionCount)
FROM read_csv_auto('{TEST_DIR}/csr_options_eager_phase_timing.csv')
WHERE Phase = 'local_csr_forward'
  AND EdgeCount = 3
  AND ThreadCount IN (1, 8);
----
1

# Eager construction remains memory-only when persistence is disabled.
statement ok
DROP PROPERTY GRAPH eager_graph;

statement ok
DROP PROPERTY GRAPH eager_graph_single_thread;

statement ok
SET experimental_persist_csr = false;

statement ok
SET experimental_build_csr_on_create = true;

statement ok
CREATE PROPERTY GRAPH eager_memory_graph
VERTEX TABLES (eager_vertex LABEL Vertex)
EDGE TABLES (
    eager_edge SOURCE KEY (src) REFERENCES eager_vertex(id)
               DESTINATION KEY (dst) REFERENCES eager_vertex(id)
               LABEL Edge
);

query I
SELECT count(*) FROM __duckpgq_csr_registry WHERE logical_key LIKE '%eager_memory_graph%';
----
0

query I
SELECT iterativelengthoperator(
    src, dst, 4::BIGINT, 3::BIGINT,
    'eager_memory_graph|eager_edge|directed'
)
FROM (SELECT 0::BIGINT AS src, 3::BIGINT AS dst);
----
3

statement ok
DROP PROPERTY GRAPH eager_memory_graph;

# Persistence alone is lazy: CREATE registers no artifact, and the first MATCH builds and persists it.
statement ok
SET experimental_build_csr_on_create = false;

statement ok
SET experimental_persist_csr = true;

statement ok
CREATE PROPERTY GRAPH lazy_persist_graph
VERTEX TABLES (eager_vertex LABEL Vertex)
EDGE TABLES (
    eager_edge SOURCE KEY (src) REFERENCES eager_vertex(id)
               DESTINATION KEY (dst) REFERENCES eager_vertex(id)
               LABEL Edge
);

query I
SELECT count(*) FROM __duckpgq_csr_registry WHERE logical_key LIKE '%lazy_persist_graph%';
----
0

query II rowsort
FROM GRAPH_TABLE(lazy_persist_graph
    MATCH p = ANY SHORTEST
        (a:Vertex WHERE a.id = 1)-[e:Edge]->{1,3}(b:Vertex)
    COLUMNS (a.id AS src, b.id AS dst)
)
ORDER BY dst;
----
1	2
1	3
1	4

query I
SELECT count(*) FROM __duckpgq_csr_registry WHERE logical_key LIKE '%lazy_persist_graph%';
----
1

statement ok
DROP PROPERTY GRAPH lazy_persist_graph;

# With both options disabled, the same lazy path publishes only to memory.
statement ok
SET experimental_persist_csr = false;

statement ok
CREATE PROPERTY GRAPH lazy_memory_graph
VERTEX TABLES (eager_vertex LABEL Vertex)
EDGE TABLES (
    eager_edge SOURCE KEY (src) REFERENCES eager_vertex(id)
               DESTINATION KEY (dst) REFERENCES eager_vertex(id)
               LABEL Edge
);

query II rowsort
FROM GRAPH_TABLE(lazy_memory_graph
    MATCH p = ANY SHORTEST
        (a:Vertex WHERE a.id = 1)-[e:Edge]->{1,3}(b:Vertex)
    COLUMNS (a.id AS src, b.id AS dst)
)
ORDER BY dst;
----
1	2
1	3
1	4

query I
SELECT count(*) FROM __duckpgq_csr_registry WHERE logical_key LIKE '%lazy_memory_graph%';
----
0

query I
SELECT iterativelengthoperator(
    src, dst, 4::BIGINT, 3::BIGINT,
    'lazy_memory_graph|eager_edge|directed'
)
FROM (SELECT 0::BIGINT AS src, 3::BIGINT AS dst);
----
3
