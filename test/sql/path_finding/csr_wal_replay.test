# name: test/sql/path_finding/csr_wal_replay.test
# description: Persisted generations and transactional invalidation survive WAL replay without an explicit checkpoint
# group: [path_finding]

require duckpgq

load {TEST_DIR}/csr_wal_replay.db

statement ok
SET wal_autocheckpoint = '1 TiB';

statement ok
SET experimental_path_finding_operator = true;

statement ok
SET experimental_persist_csr = true;

statement ok
SET experimental_build_csr_on_create = true;

statement ok
CREATE TABLE wal_vertex(id BIGINT);

statement ok
INSERT INTO wal_vertex VALUES (1), (2), (3), (4);

statement ok
CREATE TABLE wal_edge(src BIGINT, dst BIGINT);

statement ok
INSERT INTO wal_edge VALUES (1, 2), (2, 3), (3, 4);

statement ok
CREATE PROPERTY GRAPH wal_graph
VERTEX TABLES (wal_vertex LABEL Vertex)
EDGE TABLES (
    wal_edge SOURCE KEY (src) REFERENCES wal_vertex(id)
             DESTINATION KEY (dst) REFERENCES wal_vertex(id)
             LABEL Edge
);

# No CHECKPOINT: reopening must recover the active generation and owned trigger catalog state through WAL replay.
restart

statement ok
SET wal_autocheckpoint = '1 TiB';

statement ok
SET experimental_path_finding_operator = true;

statement ok
SET experimental_persist_csr = true;

query I
SELECT iterativelengthoperator(
    src, dst, 4::BIGINT, 3::BIGINT,
    'wal_graph|wal_edge|directed'
)
FROM (SELECT 0::BIGINT AS src, 3::BIGINT AS dst);
----
3

statement ok
INSERT INTO wal_edge VALUES (1, 4);

query I
SELECT valid::INTEGER
FROM __duckpgq_csr_registry
WHERE logical_key LIKE '%wal_graph|wal_edge|directed%';
----
0

restart

statement ok
SET experimental_path_finding_operator = true;

statement ok
SET experimental_persist_csr = true;

query II rowsort
FROM GRAPH_TABLE(wal_graph
    MATCH p = ANY SHORTEST
        (a:Vertex WHERE a.id = 1)-[e:Edge]->{1,3}(b:Vertex)
    COLUMNS (b.id AS dst, path_length(p) AS distance)
);
----
2	1
3	2
4	1

query II
SELECT generation, valid::INTEGER
FROM __duckpgq_csr_registry
WHERE logical_key LIKE '%wal_graph|wal_edge|directed%';
----
3	1
