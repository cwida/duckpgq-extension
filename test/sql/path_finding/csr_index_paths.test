# name: test/sql/path_finding/csr_index_paths.test
# description: element_id, vertices, edges and path_length of a shortest path are produced by the operator over a CSR index
# group: [path_finding]

require duckpgq

statement ok
SET active_grammar_extensions = ['duckpgq'];

# Vertex keys equal row ids so the operator result (keys) and the SQL fallback (row ids) can be compared.
statement ok
CREATE TABLE pv(id BIGINT);

statement ok
INSERT INTO pv VALUES (0), (1), (2), (3), (4), (5), (6);

statement ok
CREATE TABLE pe(src BIGINT, dst BIGINT);

# Row ids 0..5. 0->3 has a two-hop path via 4 (edges 3 and 4) and a three-hop path via 1 and 2.
statement ok
INSERT INTO pe VALUES (0, 1), (1, 2), (2, 3), (0, 4), (4, 3), (3, 5);

statement ok
CREATE PROPERTY GRAPH path_graph
VERTEX TABLES (pv LABEL PV)
EDGE TABLES (pe SOURCE KEY (src) REFERENCES pv (id) DESTINATION KEY (dst) REFERENCES pv (id) LABEL PE);

statement ok
CREATE INDEX pe_csr ON pe USING CSR (src, dst);

statement ok
SET experimental_path_finding_operator = true;

query IIIII
SELECT dst, path, vs, es, len FROM GRAPH_TABLE (path_graph
    MATCH p = ANY SHORTEST (a:PV WHERE a.id = 0)-[e:PE]->{1,4}(b:PV WHERE b.id IN (3, 5, 6))
    COLUMNS (b.id AS dst, element_id(p) AS path, vertices(p) AS vs, edges(p) AS es, path_length(p) AS len))
ORDER BY dst;
----
3	[0, 3, 4, 4, 3]	[0, 4, 3]	[3, 4]	2
5	[0, 3, 4, 4, 3, 5, 5]	[0, 4, 3, 5]	[3, 4, 5]	3

query I
SELECT s LIKE '%mode=shortestpath%' AND s LIKE '%csr=index%' AND s LIKE '%scheduling=source_grouped%'
FROM (SELECT duckpgq_path_finding_strategy() AS s);
----
true

# The quantifier bounds the search: three hops are no longer accepted.
query II
SELECT dst, path FROM GRAPH_TABLE (path_graph
    MATCH p = ANY SHORTEST (a:PV WHERE a.id = 0)-[e:PE]->{1,2}(b:PV WHERE b.id IN (3, 5))
    COLUMNS (b.id AS dst, element_id(p) AS path))
ORDER BY dst;
----
3	[0, 3, 4, 4, 3]

# Several sources, one search per source.
query III
SELECT src, dst, path FROM GRAPH_TABLE (path_graph
    MATCH p = ANY SHORTEST (a:PV WHERE a.id IN (0, 1, 4))-[e:PE]->*(b:PV WHERE b.id = 5)
    COLUMNS (a.id AS src, b.id AS dst, element_id(p) AS path))
ORDER BY src;
----
0	5	[0, 3, 4, 4, 3, 5, 5]
1	5	[1, 1, 2, 2, 3, 5, 5]
4	5	[4, 4, 3, 5, 5]

# A zero-length path is the vertex alone.
query II
SELECT path, len FROM GRAPH_TABLE (path_graph
    MATCH p = ANY SHORTEST (a:PV WHERE a.id = 3)-[e:PE]->*(b:PV WHERE b.id = 3)
    COLUMNS (element_id(p) AS path, path_length(p) AS len));
----
[3]	0

# Edges inserted by this transaction come from the delta overlay with their (transaction-local) row ids.
statement ok
BEGIN;

statement ok
INSERT INTO pe VALUES (0, 6);

query I
SELECT path[1] = 0 AND path[3] = 6 AND path[2] = (SELECT rowid FROM pe WHERE src = 0 AND dst = 6) AND es = [path[2]]
FROM GRAPH_TABLE (path_graph
    MATCH p = ANY SHORTEST (a:PV WHERE a.id = 0)-[e:PE]->{1,4}(b:PV WHERE b.id = 6)
    COLUMNS (element_id(p) AS path, edges(p) AS es));
----
true

statement ok
ROLLBACK;

# The SQL fallback (operator off) agrees on every projection.
statement ok
SET experimental_path_finding_operator = false;

query IIIII
SELECT dst, path, vs, es, len FROM GRAPH_TABLE (path_graph
    MATCH p = ANY SHORTEST (a:PV WHERE a.id = 0)-[e:PE]->{1,4}(b:PV WHERE b.id IN (3, 5, 6))
    COLUMNS (b.id AS dst, element_id(p) AS path, vertices(p) AS vs, edges(p) AS es, path_length(p) AS len))
ORDER BY dst;
----
3	[0, 3, 4, 4, 3]	[0, 4, 3]	[3, 4]	2
5	[0, 3, 4, 4, 3, 5, 5]	[0, 4, 3, 5]	[3, 4, 5]	3

# Without an index the operator still answers the length; path projections use the fallback.
statement ok
SET experimental_path_finding_operator = true;

statement ok
DROP INDEX pe_csr;

query III
SELECT dst, path, len FROM GRAPH_TABLE (path_graph
    MATCH p = ANY SHORTEST (a:PV WHERE a.id = 0)-[e:PE]->{1,4}(b:PV WHERE b.id IN (3, 5, 6))
    COLUMNS (b.id AS dst, element_id(p) AS path, path_length(p) AS len))
ORDER BY dst;
----
3	[0, 3, 4, 4, 3]	2
5	[0, 3, 4, 4, 3, 5, 5]	3
