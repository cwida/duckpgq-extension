# name: test/sql/path_finding/csr_index_ddl.test
# description: CREATE INDEX ... USING CSR on an edge table: creation, catalog visibility, checkpoint, drop, errors
# group: [path_finding]

require duckpgq

statement ok
CREATE TABLE person(id BIGINT PRIMARY KEY, name VARCHAR);

statement ok
CREATE TABLE knows(src BIGINT, dst BIGINT, since INTEGER);

statement ok
INSERT INTO person VALUES (1, 'a'), (2, 'b'), (3, 'c'), (4, 'd');

statement ok
INSERT INTO knows VALUES (1, 2, 2020), (2, 3, 2021), (3, 4, 2022), (1, 3, 2023);

statement ok
CREATE INDEX knows_csr ON knows USING CSR (src, dst);

query III
SELECT index_name, table_name, is_unique FROM duckdb_indexes() WHERE index_name = 'knows_csr';
----
knows_csr	knows	false

# An undirected index on the same table
statement ok
CREATE INDEX knows_csr_undirected ON knows USING CSR (src, dst) WITH (undirected = true);

query I
SELECT count(*) FROM duckdb_indexes() WHERE table_name = 'knows';
----
2

# Ordinary DML keeps working while the indexes exist
statement ok
INSERT INTO knows VALUES (4, 1, 2024);

statement ok
UPDATE knows SET since = 2025 WHERE src = 1 AND dst = 2;

statement ok
DELETE FROM knows WHERE src = 3;

query I
SELECT count(*) FROM knows;
----
4

statement ok
CHECKPOINT;

statement ok
DROP INDEX knows_csr_undirected;

query I
SELECT count(*) FROM duckdb_indexes() WHERE table_name = 'knows';
----
1

# A CSR index needs exactly two integer key columns
statement error
CREATE INDEX bad_one ON knows USING CSR (src);
----
exactly two key columns

statement error
CREATE INDEX bad_expr ON knows USING CSR (src + 1, dst);
----
plain columns

statement error
CREATE INDEX bad_type ON person USING CSR (id, name);
----
integer columns

statement error
CREATE UNIQUE INDEX bad_unique ON knows USING CSR (src, dst);
----
cannot enforce a constraint

# Dropping the table drops its index
statement ok
DROP TABLE knows;

query I
SELECT count(*) FROM duckdb_indexes() WHERE index_name = 'knows_csr';
----
0
