# name: test/sql/path_finding/shortest_path_bounded.test
# description: ANY SHORTEST with a lower bound returns the shortest walk whose length lies within the bounds (#291)
# group: [path_finding]

require duckpgq

statement ok
SET active_grammar_extensions = ['duckpgq'];

statement ok
CREATE TABLE Student(id BIGINT, name VARCHAR); INSERT INTO Student VALUES (0, 'Daniel'), (1, 'Tavneet'), (2, 'Gabor'), (3, 'Peter'), (4, 'David');

statement ok
CREATE TABLE know(src BIGINT, dst BIGINT, createDate BIGINT); INSERT INTO know VALUES (0,1, 10), (0,2, 11), (0,3, 12), (3,0, 13), (1,2, 14), (1,3, 15), (2,3, 16), (4,3, 17);

statement ok
CREATE PROPERTY GRAPH pg
VERTEX TABLES (
    Student PROPERTIES ( id, name ) LABEL Person
    )
EDGE TABLES (
    know    SOURCE KEY ( src ) REFERENCES Student ( id )
            DESTINATION KEY ( dst ) REFERENCES Student ( id )
            LABEL Knows
    );

# Daniel reaches himself through Peter in two hops; the zero-length path is outside {1,3}.
query IIII
FROM GRAPH_TABLE (pg
    MATCH
    p = ANY SHORTEST (a:Person WHERE a.name = 'Daniel')-[k:knows]->{1,3}(b:Person)
    COLUMNS (path_length(p), element_id(p), a.name AS name, b.name AS b_name)
    ) study
    ORDER BY name, b_name;
----
2	[0, 2, 3, 3, 0]	Daniel	Daniel
1	[0, 1, 2]	Daniel	Gabor
1	[0, 2, 3]	Daniel	Peter
1	[0, 0, 1]	Daniel	Tavneet

# A lower bound above the shortest distance takes the shortest walk that is long enough.
query IIII
FROM GRAPH_TABLE (pg
    MATCH
    p = ANY SHORTEST (a:Person WHERE a.name = 'Daniel')-[k:knows]->{2,3}(b:Person)
    COLUMNS (path_length(p), element_id(p), a.name AS name, b.name AS b_name)
    ) study
    ORDER BY name, b_name;
----
2	[0, 2, 3, 3, 0]	Daniel	Daniel
2	[0, 0, 1, 4, 2]	Daniel	Gabor
2	[0, 0, 1, 5, 3]	Daniel	Peter
3	[0, 2, 3, 3, 0, 0, 1]	Daniel	Tavneet

# Without a path variable the pattern keeps the same pairs: every shortest distance from Daniel is below 2.
query I
FROM GRAPH_TABLE (pg
    MATCH
    (a:Person WHERE a.name = 'Daniel')-[k:knows]->{2,3}(b:Person)
    COLUMNS (b.name AS b_name)
    ) study
    ORDER BY b_name;
----
Daniel
Gabor
Peter
Tavneet

# Exactly three hops.
query IIII
FROM GRAPH_TABLE (pg
    MATCH
    p = ANY SHORTEST (a:Person WHERE a.name = 'Daniel')-[k:knows]->{3,3}(b:Person)
    COLUMNS (path_length(p), element_id(p), a.name AS name, b.name AS b_name)
    ) study
    ORDER BY name, b_name;
----
3	[0, 0, 1, 5, 3, 3, 0]	Daniel	Daniel
3	[0, 2, 3, 3, 0, 1, 2]	Daniel	Gabor
3	[0, 2, 3, 3, 0, 2, 3]	Daniel	Peter
3	[0, 2, 3, 3, 0, 0, 1]	Daniel	Tavneet

# David has no incoming edge, so no walk of length at least one ends at him.
query IIII
FROM GRAPH_TABLE (pg
    MATCH
    p = ANY SHORTEST (a:Person WHERE a.name = 'David')-[k:knows]->+(b:Person)
    COLUMNS (path_length(p), element_id(p), a.name AS name, b.name AS b_name)
    ) study
    ORDER BY name, b_name;
----
2	[4, 7, 3, 3, 0]	David	Daniel
3	[4, 7, 3, 3, 0, 1, 2]	David	Gabor
1	[4, 7, 3]	David	Peter
3	[4, 7, 3, 3, 0, 0, 1]	David	Tavneet

# A lower bound no walk can reach returns nothing.
query IIII
FROM GRAPH_TABLE (pg
    MATCH
    p = ANY SHORTEST (a:Person WHERE a.name = 'David')-[k:knows]->{2,2}(b:Person)
    COLUMNS (path_length(p), element_id(p), a.name AS name, b.name AS b_name)
    ) study
    ORDER BY name, b_name;
----
2	[4, 7, 3, 3, 0]	David	Daniel

# The scalar function directly: NULL when no walk lies within the bounds.
query I
WITH cte1 AS (
    SELECT CREATE_CSR_EDGE(
            0,
            (SELECT count(a.id) FROM Student a),
            CAST (
                (SELECT sum(CREATE_CSR_VERTEX(
                            0,
                            (SELECT count(a.id) FROM Student a),
                            sub.dense_id,
                            sub.cnt)
                            )
                FROM (
                    SELECT a.rowid as dense_id, count(k.src) as cnt
                    FROM Student a
                    LEFT JOIN know k ON k.src = a.id
                    GROUP BY a.rowid) sub
                )
            AS BIGINT),
            (select count() FROM know k JOIN student a on a.id = k.src JOIN student c on c.id = k.dst),
            a.rowid,
            c.rowid,
            k.rowid) as temp
    FROM know k
    JOIN student a on a.id = k.src
    JOIN student c on c.id = k.dst
)
SELECT shortestpathbounded(0, (select count(*) from student), a.rowid, b.rowid, 1 + __x.temp, 2) AS path
FROM student a, student b, (select count(cte1.temp) * 0 as temp from cte1) __x
WHERE a.id = 4 AND b.id IN (0, 4)
ORDER BY b.id;
----
[4, 7, 3, 3, 0]
NULL
