# name: test/sql/path_finding/csr_index_change_groups.test
# description: Readers decide change-log visibility per commit group and share the snapshot between commits
# group: [path_finding]

require duckpgq

load {TEST_DIR}/csr_index_change_groups.db

statement ok
SET active_grammar_extensions = ['duckpgq'];

statement ok con1
SET active_grammar_extensions = ['duckpgq'];

statement ok
SET experimental_path_finding_operator = true;

statement ok con1
SET experimental_path_finding_operator = true;

# Folding off: everything goes through the change log
statement ok
SET duckpgq_csr_index_fold_ratio = 0;

statement ok con1
SET duckpgq_csr_index_fold_ratio = 0;

statement ok
CREATE TABLE person(id BIGINT);

statement ok
INSERT INTO person SELECT range FROM range(1, 21);

statement ok
CREATE TABLE knows(src BIGINT, dst BIGINT);

statement ok
INSERT INTO knows VALUES (1, 2), (2, 3);

statement ok
CREATE PROPERTY GRAPH g
VERTEX TABLES (person LABEL Person)
EDGE TABLES (knows SOURCE KEY (src) REFERENCES person(id) DESTINATION KEY (dst) REFERENCES person(id) LABEL Knows);

statement ok
CREATE INDEX knows_csr ON knows USING CSR (src, dst);

# ---- Several commits: one change group each; a multi-row commit is one group
statement ok
INSERT INTO knows VALUES (3, 4);

statement ok
INSERT INTO knows VALUES (4, 5), (4, 6), (4, 7);

statement ok
INSERT INTO knows VALUES (7, 8);

query II
SELECT d, l
FROM GRAPH_TABLE (g MATCH p = ANY SHORTEST (a:Person WHERE a.id = 1)-[k:Knows]->*(b:Person)
                  COLUMNS (b.id AS d, path_length(p) AS l))
ORDER BY d;
----
1	0
2	1
3	2
4	3
5	4
6	4
7	4
8	5

query I
SELECT duckpgq_csr_index_stats('knows', 'knows_csr');
----
epochs=1;delta=5;tombstones=0

# ---- Deleting the first row of a multi-row group must not hide the rest of the group
statement ok
DELETE FROM knows WHERE src = 4 AND dst = 5;

query II
SELECT d, l
FROM GRAPH_TABLE (g MATCH p = ANY SHORTEST (a:Person WHERE a.id = 1)-[k:Knows]->*(b:Person)
                  COLUMNS (b.id AS d, path_length(p) AS l))
ORDER BY d;
----
1	0
2	1
3	2
4	3
6	4
7	4
8	5

# A deleted delta row is stamped, not tombstoned
query I
SELECT duckpgq_csr_index_stats('knows', 'knows_csr');
----
epochs=1;delta=5;tombstones=0

# ---- An uncommitted delete of a delta row is invisible to other readers; a rolled-back one never shows
statement ok con1
BEGIN TRANSACTION;

statement ok con1
DELETE FROM knows WHERE src = 7 AND dst = 8;

query I
SELECT count(*)
FROM GRAPH_TABLE (g MATCH p = ANY SHORTEST (a:Person WHERE a.id = 1)-[k:Knows]->*(b:Person)
                  COLUMNS (b.id AS d, path_length(p) AS l));
----
7

statement ok con1
ROLLBACK;

query I
SELECT count(*)
FROM GRAPH_TABLE (g MATCH p = ANY SHORTEST (a:Person WHERE a.id = 1)-[k:Knows]->*(b:Person)
                  COLUMNS (b.id AS d, path_length(p) AS l));
----
7

# ---- A reader that started before a commit sees the groups up to its start only
statement ok con1
BEGIN TRANSACTION;

query I con1
SELECT count(*)
FROM GRAPH_TABLE (g MATCH p = ANY SHORTEST (a:Person WHERE a.id = 1)-[k:Knows]->*(b:Person)
                  COLUMNS (b.id AS d, path_length(p) AS l));
----
7

statement ok
INSERT INTO knows VALUES (8, 9);

statement ok
DELETE FROM knows WHERE src = 1 AND dst = 2;

query I con1
SELECT count(*)
FROM GRAPH_TABLE (g MATCH p = ANY SHORTEST (a:Person WHERE a.id = 1)-[k:Knows]->*(b:Person)
                  COLUMNS (b.id AS d, path_length(p) AS l));
----
7

statement ok con1
COMMIT;

# The epoch edge (1, 2) is tombstoned; only the source itself remains reachable
query I con1
SELECT count(*)
FROM GRAPH_TABLE (g MATCH p = ANY SHORTEST (a:Person WHERE a.id = 1)-[k:Knows]->*(b:Person)
                  COLUMNS (b.id AS d, path_length(p) AS l));
----
1

query I
SELECT duckpgq_csr_index_stats('knows', 'knows_csr');
----
epochs=1;delta=6;tombstones=1

# ---- A fold rebuilds the dictionary in key order; a new smallest key shifts every id. Entries appended before the
# fold stay in the log while the previous epoch is retained and must be read with ids of the new dictionary.
statement ok
INSERT INTO person VALUES (0);

statement ok
INSERT INTO knows VALUES (0, 1);

statement ok
INSERT INTO knows VALUES (6, 11), (11, 12);

query I
SELECT duckpgq_csr_index_fold('knows', 'knows_csr');
----
true

query I
SELECT duckpgq_csr_index_stats('knows', 'knows_csr') LIKE 'epochs=2;%';
----
true

query II
SELECT d, l
FROM GRAPH_TABLE (g MATCH p = ANY SHORTEST (a:Person WHERE a.id = 2)-[k:Knows]->*(b:Person)
                  COLUMNS (b.id AS d, path_length(p) AS l))
ORDER BY d;
----
2	0
3	1
4	2
6	3
7	3
8	4
9	5
11	4
12	5

# ---- Restart: loaded entries carry no group and are decided per row, deletes after the restart are grouped
statement ok
CHECKPOINT;

restart

statement ok
SET active_grammar_extensions = ['duckpgq'];

statement ok
SET experimental_path_finding_operator = true;

statement ok
SET duckpgq_csr_index_fold_ratio = 0;

query II
SELECT d, l
FROM GRAPH_TABLE (g MATCH p = ANY SHORTEST (a:Person WHERE a.id = 2)-[k:Knows]->*(b:Person)
                  COLUMNS (b.id AS d, path_length(p) AS l))
ORDER BY d;
----
2	0
3	1
4	2
6	3
7	3
8	4
9	5
11	4
12	5

statement ok
DELETE FROM knows WHERE src = 4 AND dst = 7;

statement ok
INSERT INTO knows VALUES (6, 10);

query II
SELECT d, l
FROM GRAPH_TABLE (g MATCH p = ANY SHORTEST (a:Person WHERE a.id = 2)-[k:Knows]->*(b:Person)
                  COLUMNS (b.id AS d, path_length(p) AS l))
ORDER BY d;
----
2	0
3	1
4	2
6	3
10	4
11	4
12	5

query I
SELECT duckpgq_path_finding_strategy() LIKE '%csr=index%';
----
true

# ---- A fold compacts the stamped and loaded entries
query I
SELECT duckpgq_csr_index_fold('knows', 'knows_csr');
----
true

query II
SELECT d, l
FROM GRAPH_TABLE (g MATCH p = ANY SHORTEST (a:Person WHERE a.id = 2)-[k:Knows]->*(b:Person)
                  COLUMNS (b.id AS d, path_length(p) AS l))
ORDER BY d;
----
2	0
3	1
4	2
6	3
10	4
11	4
12	5
