# name: test/sql/path_finding/bidirectional_pair.test
# description: a source group with one destination is searched from both ends over a CSR index with a reverse side (reverse = true, or undirected); lengths equal the search from the source, paths are valid shortest paths
# group: [path_finding]

require duckpgq

statement ok
SET active_grammar_extensions = ['duckpgq'];

statement ok
SET experimental_path_finding_operator = true;

# 1999 vertices with three outgoing edges each (v -> 1922 v + 13 + 131 k mod 1999), and a chain 5000 -> ... -> 5004
statement ok
CREATE TABLE e AS
SELECT (i % 1999)::BIGINT AS src, ((i * 7919 + (i // 1999) * 131 + 13) % 1999)::BIGINT AS dst FROM range(5997) t(i)
UNION ALL
SELECT 5000 + i, 5001 + i FROM range(4) t(i);

statement ok
CREATE TABLE v AS SELECT DISTINCT src AS id FROM e UNION SELECT DISTINCT dst FROM e;

statement ok
CREATE PROPERTY GRAPH g
VERTEX TABLES (v LABEL V)
EDGE TABLES (e SOURCE KEY (src) REFERENCES v (id) DESTINATION KEY (dst) REFERENCES v (id) LABEL E);

statement ok
CREATE INDEX e_rev ON e USING CSR (src, dst) WITH (reverse = true);

# Distinct sources, one destination each: along the chain, against it, across components, a self pair
statement ok
CREATE TABLE pairs AS
SELECT (i * 37 % 1999)::BIGINT AS src, ((i * 811 + 5) % 1999)::BIGINT AS dst FROM range(10) t(i)
UNION ALL
VALUES (5000, 5004), (5004, 5000), (5001, 7), (1998, 1998);

statement ok
CREATE TABLE both_ends AS
SELECT src, dst, iterativelengthoperator(src, dst, 0::BIGINT, 0::BIGINT, 'csr-index|memory|main|e|e_rev') AS len
FROM pairs;

query I
SELECT s LIKE '%source_group_kernel=per_source%' AND s LIKE '%bidirectional_searches=14;%'
FROM (SELECT duckpgq_path_finding_strategy() || ';' AS s);
----
true

query III
SELECT src, dst, len FROM both_ends WHERE src >= 1998 ORDER BY src;
----
1998	1998	0
5000	5004	4
5001	7	NULL
5004	5000	NULL

statement ok
SET experimental_path_finding_operator_bidirectional_pair = false;

statement ok
CREATE TABLE one_end AS
SELECT src, dst, iterativelengthoperator(src, dst, 0::BIGINT, 0::BIGINT, 'csr-index|memory|main|e|e_rev') AS len
FROM pairs;

query I
SELECT s LIKE '%source_group_kernel=per_source%' AND s NOT LIKE '%bidirectional_searches%'
FROM (SELECT duckpgq_path_finding_strategy() AS s);
----
true

statement ok
RESET experimental_path_finding_operator_bidirectional_pair;

query II
SELECT count(*), count(*) FILTER (b.len IS DISTINCT FROM o.len) FROM both_ends b JOIN one_end o USING (src, dst);
----
14	0

# 600 distinct sources on the per-source kernel, each searched from both ends, against the MS-BFS lanes
statement ok
CREATE TABLE many AS
SELECT i::BIGINT AS src, ((i * 811 + 5) % 1999)::BIGINT AS dst FROM range(600) t(i);

statement ok
CREATE TABLE many_lanes AS
SELECT src, dst, iterativelengthoperator(src, dst, 0::BIGINT, 0::BIGINT, 'csr-index|memory|main|e|e_rev') AS len
FROM many;

query I
SELECT s LIKE '%source_group_kernel=lane_waves%' FROM (SELECT duckpgq_path_finding_strategy() AS s);
----
true

statement ok
SET experimental_path_finding_operator_few_sources_limit = 1000000;

statement ok
CREATE TABLE many_both_ends AS
SELECT src, dst, iterativelengthoperator(src, dst, 0::BIGINT, 0::BIGINT, 'csr-index|memory|main|e|e_rev') AS len
FROM many;

query I
SELECT s LIKE '%source_group_kernel=per_source%' AND s LIKE '%bidirectional_searches=600;%'
FROM (SELECT duckpgq_path_finding_strategy() || ';' AS s);
----
true

query III
SELECT count(*), count(b.len), count(*) FILTER (b.len IS DISTINCT FROM o.len)
FROM many_both_ends b JOIN many_lanes o USING (src, dst);
----
600	600	0

# Paths: the forward half carries the row ids of the forward partitions, the backward half looks its edges up there
statement ok
CREATE TABLE many_paths AS
SELECT src, dst, shortestpathoperator(src, dst, 0::BIGINT, 0::BIGINT, 'csr-index|memory|main|e|e_rev') AS path
FROM many;

query I
SELECT s LIKE '%mode=shortestpath%' AND s LIKE '%bidirectional_searches=600;%'
FROM (SELECT duckpgq_path_finding_strategy() || ';' AS s);
----
true

# Every path has the length of the shortest path and runs from the source to the destination
query I
SELECT count(*) FROM many_paths p JOIN many_lanes o USING (src, dst)
WHERE (len(p.path) - 1) // 2 IS DISTINCT FROM o.len OR p.path[1] <> p.src OR p.path[-1] <> p.dst;
----
0

# Every step is an edge of the table: the row id between two vertices is that of an edge from the first to the second
query II
SELECT count(*), count(*) FILTER (e.src IS DISTINCT FROM s.v_from OR e.dst IS DISTINCT FROM s.v_to)
FROM (SELECT path[2 * k - 1] AS v_from, path[2 * k] AS edge_row, path[2 * k + 1] AS v_to
      FROM (SELECT path, unnest(range(1, (len(path) - 1) // 2 + 1)) AS k FROM many_paths)) s
LEFT JOIN e ON e.rowid = s.edge_row;
----
3917	0

# The undirected index serves both sides from the same partitions; its mirrored edges carry the edge's row id
statement ok
CREATE INDEX e_und ON e USING CSR (src, dst) WITH (undirected = true);

statement ok
CREATE TABLE und_paths AS
SELECT src, dst, shortestpathoperator(src, dst, 0::BIGINT, 0::BIGINT, 'csr-index|memory|main|e|e_und') AS path
FROM many;

query I
SELECT s LIKE '%bidirectional_searches=600;%' FROM (SELECT duckpgq_path_finding_strategy() || ';' AS s);
----
true

statement ok
SET experimental_path_finding_operator_bidirectional_pair = false;

statement ok
CREATE TABLE und_one_end AS
SELECT src, dst, iterativelengthoperator(src, dst, 0::BIGINT, 0::BIGINT, 'csr-index|memory|main|e|e_und') AS len
FROM many;

statement ok
RESET experimental_path_finding_operator_bidirectional_pair;

query I
SELECT count(*) FROM und_paths p JOIN und_one_end o USING (src, dst)
WHERE (len(p.path) - 1) // 2 IS DISTINCT FROM o.len OR p.path[1] <> p.src OR p.path[-1] <> p.dst;
----
0

query II
SELECT count(*), count(*) FILTER (NOT ((e.src = s.v_from AND e.dst = s.v_to) OR (e.src = s.v_to AND e.dst = s.v_from)))
FROM (SELECT path[2 * k - 1] AS v_from, path[2 * k] AS edge_row, path[2 * k + 1] AS v_to
      FROM (SELECT path, unnest(range(1, (len(path) - 1) // 2 + 1)) AS k FROM und_paths)) s
LEFT JOIN e ON e.rowid = s.edge_row;
----
2986	0

statement ok
DROP INDEX e_und;

statement ok
RESET experimental_path_finding_operator_few_sources_limit;

# The hop bound of the pattern: the chain's four hops are found within four and not within three
query II
SELECT len, vs FROM GRAPH_TABLE (g
    MATCH p = ANY SHORTEST (a:V WHERE a.id = 5000)-[x:E]->{1,4}(b:V WHERE b.id = 5004)
    COLUMNS (path_length(p) AS len, vertices(p) AS vs));
----
4	[5000, 5001, 5002, 5003, 5004]

query I
SELECT s LIKE '%csr=index%' AND s LIKE '%bidirectional_searches=1;%'
FROM (SELECT duckpgq_path_finding_strategy() || ';' AS s);
----
true

query I
SELECT count(*) FROM GRAPH_TABLE (g
    MATCH p = ANY SHORTEST (a:V WHERE a.id = 5000)-[x:E]->{1,3}(b:V WHERE b.id = 5004)
    COLUMNS (path_length(p) AS len));
----
0

# A source with several destinations keeps the search from the source
query II
SELECT dst, len FROM GRAPH_TABLE (g
    MATCH p = ANY SHORTEST (a:V WHERE a.id = 5000)-[x:E]->*(b:V WHERE b.id IN (5002, 5004))
    COLUMNS (b.id AS dst, path_length(p) AS len))
ORDER BY dst;
----
5002	2
5004	4

query I
SELECT s LIKE '%bidirectional_searches=0;%' FROM (SELECT duckpgq_path_finding_strategy() || ';' AS s);
----
true

# Changes after the index was built: the overlay of both sides (a new edge closes the chain into a cycle, a deleted
# edge opens it elsewhere)
statement ok
SET duckpgq_csr_index_fold_ratio = 1000;

statement ok
INSERT INTO e VALUES (5004, 5000);

statement ok
DELETE FROM e WHERE src = 5001 AND dst = 5002;

query III
SELECT src, dst, shortestpathoperator(src, dst, 0::BIGINT, 0::BIGINT, 'csr-index|memory|main|e|e_rev') AS path
FROM (VALUES (5004, 5001), (5000, 5003), (5002, 5001)) t(src, dst) ORDER BY src;
----
5000	5003	NULL
5002	5001	[5002, 5999, 5003, 6000, 5004, 6001, 5000, 5997, 5001]
5004	5001	[5004, 6001, 5000, 5997, 5001]

query I
SELECT s LIKE '%bidirectional_searches=3;%' FROM (SELECT duckpgq_path_finding_strategy() || ';' AS s);
----
true

# Large frontiers are expanded by a sweep over the partitions; divisor 0 sweeps every level (the overlay included)
statement ok
SET experimental_path_finding_operator_few_sources_limit = 1000000;

statement ok
SET experimental_path_finding_operator_sparse_frontier_divisor = 0;

statement ok
CREATE TABLE sweep_paths AS
SELECT src, dst, shortestpathoperator(src, dst, 0::BIGINT, 0::BIGINT, 'csr-index|memory|main|e|e_rev') AS path
FROM (SELECT * FROM many UNION ALL VALUES (5004, 5001), (5000, 5003), (5002, 5001));

query I
SELECT s LIKE '%bidirectional_searches=603;%' FROM (SELECT duckpgq_path_finding_strategy() || ';' AS s);
----
true

query II
SELECT count(*), count(*) FILTER ((len(p.path) - 1) // 2 IS DISTINCT FROM o.len OR p.path[1] <> p.src OR p.path[-1] <> p.dst)
FROM sweep_paths p JOIN many_lanes o USING (src, dst);
----
600	0

query II
SELECT count(*), count(*) FILTER (e.src IS DISTINCT FROM s.v_from OR e.dst IS DISTINCT FROM s.v_to)
FROM (SELECT path[2 * k - 1] AS v_from, path[2 * k] AS edge_row, path[2 * k + 1] AS v_to
      FROM (SELECT path, unnest(range(1, (len(path) - 1) // 2 + 1)) AS k FROM sweep_paths WHERE src < 5000)) s
LEFT JOIN e ON e.rowid = s.edge_row;
----
3917	0

query III
SELECT src, dst, path FROM sweep_paths WHERE src >= 5000 ORDER BY src;
----
5000	5003	NULL
5002	5001	[5002, 5999, 5003, 6000, 5004, 6001, 5000, 5997, 5001]
5004	5001	[5004, 6001, 5000, 5997, 5001]
