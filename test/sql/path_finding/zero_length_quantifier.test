# name: test/sql/path_finding/zero_length_quantifier.test
# description: A {0,0} quantifier traverses no edge, so it binds both endpoints to the same vertex (issue #9)
# group: [path_finding]

require duckpgq

statement ok
SET active_grammar_extensions = ['duckpgq'];

statement ok
CREATE TABLE student(id INT); INSERT INTO student(id) VALUES (10), (20), (30), (40);

statement ok
CREATE TABLE know(src INT, dst INT); INSERT INTO know(src, dst) VALUES (40, 20), (10,30), (10,10), (20,10), (30,10);

statement ok
CREATE TABLE school(id INT); INSERT INTO school(id) VALUES (10), (20);

statement ok
CREATE TABLE studies(student_id INT, school_id INT); INSERT INTO studies VALUES (10, 10), (20, 20);

statement ok
CREATE PROPERTY GRAPH g
VERTEX TABLES (student, school)
EDGE TABLES (
    know SOURCE KEY (src) REFERENCES student (id) DESTINATION KEY (dst) REFERENCES student (id),
    studies SOURCE KEY (student_id) REFERENCES student (id) DESTINATION KEY (school_id) REFERENCES school (id)
    );

# The query from the issue
query II
FROM GRAPH_TABLE (g
    MATCH ANY SHORTEST (a:student)-[k:know]->{0,0}(b:student)
    WHERE a.id = 10
    COLUMNS (a.id AS a_id, b.id AS b_id)
    );
----
10	10

# {1,1} still traverses exactly one edge
query II rowsort
FROM GRAPH_TABLE (g
    MATCH ANY SHORTEST (a:student)-[k:know]->{1,1}(b:student)
    WHERE a.id = 10
    COLUMNS (a.id AS a_id, b.id AS b_id)
    );
----
10	10
10	30

query II rowsort
FROM GRAPH_TABLE (g
    MATCH (a:student)-[k:know]->{0,0}(b:student)
    COLUMNS (a.id AS a_id, b.id AS b_id)
    );
----
10	10
20	20
30	30
40	40

query II rowsort
FROM GRAPH_TABLE (g
    MATCH (a:student)<-[k:know]-{0,0}(b:student)
    COLUMNS (a.id AS a_id, b.id AS b_id)
    );
----
10	10
20	20
30	30
40	40

query II rowsort
FROM GRAPH_TABLE (g
    MATCH (a:student)-[k:know]-{0,0}(b:student WHERE b.id >= 30)
    COLUMNS (a.id AS a_id, b.id AS b_id)
    );
----
30	30
40	40

# A student is never a school, so a zero-length path between them does not exist
query II
FROM GRAPH_TABLE (g
    MATCH (a:student)-[s:studies]->{0,0}(b:school)
    COLUMNS (a.id AS a_id, b.id AS b_id)
    );
----

# The zero-length step followed by a plain edge
query III rowsort
FROM GRAPH_TABLE (g
    MATCH (a:student WHERE a.id = 10)-[k:know]->{0,0}(b:student)-[k2:know]->(c:student)
    COLUMNS (a.id AS a_id, b.id AS b_id, c.id AS c_id)
    );
----
10	10	10
10	10	30

# A named zero-length path consists of the start vertex only
query IIIIII
FROM GRAPH_TABLE (g
    MATCH p = ANY SHORTEST (a:student WHERE a.id = 20)-[k:know]->{0,0}(b:student)
    COLUMNS (a.id AS a_id, b.id AS b_id, path_length(p) AS len, element_id(p) AS elements, vertices(p) AS v, edges(p) AS e)
    );
----
20	20	0	[1]	[1]	[]

# Two path functions over one path with an inline vertex WHERE used to dereference a moved (null) clause
query II
FROM GRAPH_TABLE (g
    MATCH p = ANY SHORTEST (a:student WHERE a.id = 20)-[k:know]->{0,0}(b:student)
    COLUMNS (path_length(p), element_id(p))
    );
----
0	[1]

query II
FROM GRAPH_TABLE (g
    MATCH p = ANY SHORTEST (a:student WHERE a.id = 20)-[k:know]->{1,1}(b:student)
    COLUMNS (path_length(p), element_id(p))
    );
----
1	[1, 3, 0]

# {0} and {,0} have the same bounds as {0,0}
query II rowsort
FROM GRAPH_TABLE (g
    MATCH (a:student)-[k:know]->{0}(b:student)
    COLUMNS (a.id AS a_id, b.id AS b_id)
    );
----
10	10
20	20
30	30
40	40

query II rowsort
FROM GRAPH_TABLE (g
    MATCH (a:student)-[k:know]->{,0}(b:student)
    COLUMNS (a.id AS a_id, b.id AS b_id)
    );
----
10	10
20	20
30	30
40	40

# The edge pattern of a {0,0} edge is never evaluated, so its WHERE does not filter
query II rowsort
FROM GRAPH_TABLE (g
    MATCH (a:student)-[k:know WHERE k.src > 25]->{0,0}(b:student)
    COLUMNS (a.id AS a_id, b.id AS b_id)
    );
----
10	10
20	20
30	30
40	40

# COLUMNS (*) does not expand the edge variable of a {0,0} edge, which is bound to no edge
query II rowsort
FROM GRAPH_TABLE (g
    MATCH (a:student)-[k:know]->{0,0}(b:student)
    COLUMNS (*)
    );
----
10	10
20	20
30	30
40	40

# Nor that of a path-finding edge (the star's column order is unspecified, hence the sum)
query I rowsort
SELECT id + id_1 FROM GRAPH_TABLE (g
    MATCH (a:student WHERE a.id = 40)-[k:know]->{1,3}(b:student)
    COLUMNS (*)
    );
----
50
60
70

# Named paths that combine {0,0} with other edges
query IIIII
FROM GRAPH_TABLE (g
    MATCH p = ANY SHORTEST (a:student WHERE a.id = 40)-[k:know]->(b:student)-[k2:know]->{0,0}(c:student)
    COLUMNS (a.id AS a_id, b.id AS b_id, c.id AS c_id, path_length(p) AS len, element_id(p) AS elements)
    );
----
40	20	20	1	[3, 0, 1]

query IIIII
FROM GRAPH_TABLE (g
    MATCH p = ANY SHORTEST (a:student WHERE a.id = 40)-[k:know]->{0,0}(b:student)-[k2:know]->(c:student)
    COLUMNS (a.id AS a_id, b.id AS b_id, c.id AS c_id, path_length(p) AS len, element_id(p) AS elements)
    );
----
40	40	20	1	[3, 0, 1]

query IIIII
FROM GRAPH_TABLE (g
    MATCH p = ANY SHORTEST (a:student WHERE a.id = 40)-[k:know]->{1,3}(b:student WHERE b.id = 30)-[k2:know]->{0,0}(c:student)
    COLUMNS (a.id AS a_id, b.id AS b_id, c.id AS c_id, path_length(p) AS len, element_id(p) AS elements)
    );
----
40	30	30	3	[3, 0, 1, 3, 0, 1, 2]

query IIIII
FROM GRAPH_TABLE (g
    MATCH p = ANY SHORTEST (a:student WHERE a.id = 40)-[k:know]->{0,0}(b:student)-[k2:know]->{1,3}(c:student WHERE c.id = 30)
    COLUMNS (a.id AS a_id, b.id AS b_id, c.id AS c_id, path_length(p) AS len, element_id(p) AS elements)
    );
----
40	40	30	3	[3, 0, 1, 3, 0, 1, 2]

# {0,0} in the second path pattern of a MATCH
query III rowsort
FROM GRAPH_TABLE (g
    MATCH (a:student WHERE a.id = 10)-[k:know]->(b:student), (b:student)-[k2:know]->{0,0}(c:student)
    COLUMNS (a.id AS a_id, b.id AS b_id, c.id AS c_id)
    );
----
10	10	10
10	30	30

# Endpoints in different vertex tables under ANY SHORTEST, with and without a path variable
query II
FROM GRAPH_TABLE (g
    MATCH ANY SHORTEST (a:student)-[s:studies]->{0,0}(b:school)
    COLUMNS (a.id AS a_id, b.id AS b_id)
    );
----

query III
FROM GRAPH_TABLE (g
    MATCH p = ANY SHORTEST (a:student)-[s:studies]->{0,0}(b:school)
    COLUMNS (a.id AS a_id, b.id AS b_id, path_length(p) AS len)
    );
----

# A graph with PK/FK constraints, where vertex-join elimination runs; the {0,0} endpoints must stay joined
statement ok
CREATE TABLE person(id BIGINT PRIMARY KEY, name VARCHAR); INSERT INTO person VALUES (1, 'a'), (2, 'b'), (3, 'c');

statement ok
CREATE TABLE knows(src BIGINT REFERENCES person(id), dst BIGINT REFERENCES person(id)); INSERT INTO knows VALUES (1, 2), (2, 3), (3, 1);

statement ok
CREATE PROPERTY GRAPH pg
VERTEX TABLES (person)
EDGE TABLES (knows SOURCE KEY (src) REFERENCES person (id) DESTINATION KEY (dst) REFERENCES person (id));

query II rowsort
FROM GRAPH_TABLE (pg
    MATCH (a:person)-[k:knows]->{0,0}(b:person)
    COLUMNS (a.id AS a_id, b.id AS b_id)
    );
----
1	1
2	2
3	3

query II rowsort
FROM GRAPH_TABLE (pg
    MATCH (a:person)-[k:knows]->{0,0}(b:person)-[k2:knows]->(c:person)
    COLUMNS (k2.src, k2.dst)
    );
----
1	2
2	3
3	1

query II rowsort
FROM GRAPH_TABLE (pg
    MATCH (a:person)-[k2:knows]->(b:person)-[k:knows]->{0,0}(c:person)
    COLUMNS (k2.src, k2.dst)
    );
----
1	2
2	3
3	1

query II
FROM GRAPH_TABLE (pg
    MATCH p = ANY SHORTEST (a:person WHERE a.id = 2)-[k:knows]->{0,0}(b:person)
    COLUMNS (path_length(p), element_id(p))
    );
----
0	[1]

# Sub-labels of one discriminator table are the same vertex table
statement ok
CREATE TABLE member(id INT, kind INT); INSERT INTO member VALUES (1, 1), (2, 2), (3, 1);

statement ok
CREATE TABLE friend(src INT, dst INT); INSERT INTO friend VALUES (1, 2), (2, 3);

statement ok
CREATE PROPERTY GRAPH gs
VERTEX TABLES (member LABEL person IN kind(student, teacher))
EDGE TABLES (friend SOURCE KEY (src) REFERENCES member (id) DESTINATION KEY (dst) REFERENCES member (id) LABEL friend);

query II
FROM GRAPH_TABLE (gs
    MATCH (a:student)-[f:friend]->{0,0}(b:teacher)
    COLUMNS (a.id AS a_id, b.id AS b_id)
    );
----

query II rowsort
FROM GRAPH_TABLE (gs
    MATCH (a:student)-[f:friend]->{0,0}(b:person)
    COLUMNS (a.id AS a_id, b.id AS b_id)
    );
----
1	1
3	3

query II rowsort
FROM GRAPH_TABLE (gs
    MATCH (a:student)-[f:friend]->{0,0}(b:student)
    COLUMNS (a.id AS a_id, b.id AS b_id)
    );
----
1	1
3	3
