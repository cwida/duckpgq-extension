    CAST ((SELECT sum(CREATE_CSR_VERTEX(0, (SELECT count(a.id) FROM Student a), sub.dense_id, sub.cnt))
           FROM (SELECT a.rowid AS dense_id, count(k.src) AS cnt FROM Student a
                 LEFT JOIN KnowU k ON k.src = a.id GROUP BY a.rowid) sub) AS BIGINT),
    (SELECT count() FROM KnowU k JOIN Student a ON a.id = k.src JOIN Student c ON c.id = k.dst),
    a.rowid, c.rowid, k.rowid) AS temp
    FROM KnowU k JOIN Student a ON a.id = k.src JOIN Student c ON c.id = k.dst;

query III rowsort
