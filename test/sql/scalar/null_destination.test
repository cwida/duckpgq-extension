# shortestpath (vertex, edge, vertex ids): interleaved NULL sources and destinations
statement ok
SELECT CREATE_CSR_EDGE(0, (SELECT count(a.id) FROM Student a),
    CAST ((SELECT sum(CREATE_CSR_VERTEX(0, (SELECT count(a.id) FROM Student a), sub.dense_id, sub.cnt))
           FROM (SELECT a.rowid AS dense_id, count(k.src) AS cnt FROM Student a
                 LEFT JOIN Know k ON k.src = a.id GROUP BY a.rowid) sub) AS BIGINT),
    (SELECT count() FROM Know k JOIN Student a ON a.id = k.src JOIN Student c ON c.id = k.dst),
    a.rowid, c.rowid, k.rowid) AS temp
    FROM Know k JOIN Student a ON a.id = k.src JOIN Student c ON c.id = k.dst;

query III rowsort
SELECT x, y, shortestpath(0, 5, x, y) FROM (VALUES (0::BIGINT, 1::BIGINT), (0::BIGINT, NULL::BIGINT), (NULL::BIGINT, 2::BIGINT), (1::BIGINT, 3::BIGINT), (4::BIGINT, NULL::BIGINT), (NULL::BIGINT, NULL::BIGINT), (NULL::BIGINT, 3::BIGINT), (2::BIGINT, 3::BIGINT)) t(x, y);
----
0	1	[0, 0, 1]
0	NULL	NULL
NULL	2	NULL
1	3	[1, 5, 3]
4	NULL	NULL
NULL	NULL	NULL
NULL	3	NULL
2	3	[2, 6, 3]

# iterativelength: all rows NULL
statement ok
SELECT CREATE_CSR_EDGE(0, (SELECT count(a.id) FROM Student a),
    CAST ((SELECT sum(CREATE_CSR_VERTEX(0, (SELECT count(a.id) FROM Student a), sub.dense_id, sub.cnt))
           FROM (SELECT a.rowid AS dense_id, count(k.src) AS cnt FROM Student a
                 LEFT JOIN Know k ON k.src = a.id GROUP BY a.rowid) sub) AS BIGINT),
    (SELECT count() FROM Know k JOIN Student a ON a.id = k.src JOIN Student c ON c.id = k.dst),
    a.rowid, c.rowid, k.rowid) AS temp
    FROM Know k JOIN Student a ON a.id = k.src JOIN Student c ON c.id = k.dst;

query III
SELECT x, y, iterativelength(0, 5, x, y) FROM (VALUES (NULL::BIGINT, NULL::BIGINT), (NULL::BIGINT, 2::BIGINT), (1::BIGINT, NULL::BIGINT)) t(x, y);
----
NULL	NULL	NULL
NULL	2	NULL
1	NULL	NULL

