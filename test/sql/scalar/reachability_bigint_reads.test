# reachability (is_variant = false): is the target reachable from the source
query III rowsort
SELECT a.id, b.id, reachability(0, false, (SELECT count(*) FROM Student), a.rowid, b.rowid) FROM Student a, Student b;
----
0	0	true
0	1	true
0	2	true
0	3	true
0	4	false
1	0	true
1	1	true
1	2	true
1	3	true
1	4	false
2	0	true
2	1	true
2	2	true
2	3	true
2	4	false
3	0	true
3	1	true
3	2	true
3	3	true
3	4	false
4	0	true
4	1	true
4	2	true
4	3	true
4	4	true

