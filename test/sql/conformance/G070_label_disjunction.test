# name: test/sql/conformance/G070_label_disjunction.test
# description: 10.8 <label expression>: label disjunction with | (G070, mandatory per 18.1) and single labels (G073)
# group: [conformance]

require duckpgq

statement ok
SET active_grammar_extensions = ['duckpgq'];

statement ok
CREATE TABLE Person(id BIGINT, name VARCHAR); INSERT INTO Person VALUES (1, 'Daniel'), (2, 'Tavneet'), (3, 'Gabor');

# Organisation rows carry the sublabel university (bit 1) or company (bit 2) in the mask column.
statement ok
CREATE TABLE Organisation(id BIGINT, name VARCHAR, mask BIGINT); INSERT INTO Organisation VALUES (10, 'VU', 1), (11, 'UvA', 1), (20, 'CWI', 2);

# worksAt rows carry the sublabel employee (bit 1) or intern (bit 2) in the kind column.
statement ok
CREATE TABLE worksAt(personId BIGINT, organisationId BIGINT, kind BIGINT); INSERT INTO worksAt VALUES (1, 20, 1), (2, 20, 2), (3, 10, 1);

statement ok
CREATE PROPERTY GRAPH pg
VERTEX TABLES (
    Person LABEL Person,
    Organisation LABEL Organisation IN mask (university, company)
)
EDGE TABLES (
    worksAt SOURCE KEY (personId) REFERENCES Person (id) DESTINATION KEY (organisationId) REFERENCES Organisation (id)
            LABEL worksAt IN kind (employee, intern)
);

# A single label (G073) selects the rows carrying it.
query I
FROM GRAPH_TABLE (pg MATCH (o:university) COLUMNS (o.name)) ORDER BY 1;
----
UvA
VU

# A disjunction of two sublabels of the same table.
query I
FROM GRAPH_TABLE (pg MATCH (o:university|company) COLUMNS (o.name)) ORDER BY 1;
----
CWI
UvA
VU

# A disjunction that includes the table's main label holds for every row.
query I
FROM GRAPH_TABLE (pg MATCH (o:university|Organisation) COLUMNS (o.name)) ORDER BY 1;
----
CWI
UvA
VU

# IS is an alternative spelling of the colon.
query I
FROM GRAPH_TABLE (pg MATCH (o IS company|university) COLUMNS (o.name)) ORDER BY 1;
----
CWI
UvA
VU

# Label disjunction on an edge pattern.
query II
FROM GRAPH_TABLE (pg MATCH (p:Person)-[w:employee|intern]->(o:company) COLUMNS (p.name, o.name)) ORDER BY 1;
----
Daniel	CWI
Tavneet	CWI

query II
FROM GRAPH_TABLE (pg MATCH (p:Person)-[w:intern]->(o:Organisation) COLUMNS (p.name, o.name)) ORDER BY 1;
----
Tavneet	CWI

# Label expressions combine with WHERE and with anonymous elements.
query III
FROM GRAPH_TABLE (pg MATCH (p:Person)-[w:intern|employee]->(o:university|company) WHERE o.name <> 'CWI'
    COLUMNS (p.name, o.name, w.kind)) ORDER BY 1;
----
Gabor	VU	1

query II
FROM GRAPH_TABLE (pg MATCH (o:university|company)-[]-(p:Person) COLUMNS (o.name, p.name)) ORDER BY 1, 2;
----
CWI	Daniel
CWI	Tavneet
VU	Gabor

# A disjunction over the main label of a quantified edge selects the whole table and is allowed.
query II
FROM GRAPH_TABLE (pg MATCH (p:Person)-[w:worksAt|employee]->{1,1}(o:Organisation) COLUMNS (p.name, o.name)) ORDER BY 1;
----
Daniel	CWI
Gabor	VU
Tavneet	CWI

# Every label in the expression must exist.
statement error
FROM GRAPH_TABLE (pg MATCH (o:university|nonexistent) COLUMNS (o.name));
----
Binder Error: The label nonexistent is not registered in property graph pg

# DuckPGQ binds an element to one table, so a disjunction across tables is not supported.
statement error
FROM GRAPH_TABLE (pg MATCH (x:Person|university) COLUMNS (x.name));
----
Not implemented Error: Label expression Person|university matches several tables (Person, Organisation); an element pattern binds to one table in DuckPGQ

# Path-finding reads the whole edge table, so a sublabel filter on a quantified edge is rejected.
statement error
FROM GRAPH_TABLE (pg MATCH (p:Person)-[w:intern|employee]->{1,2}(o:Organisation) COLUMNS (p.name, o.name));
----
Not implemented Error: Label expression intern|employee selects part of table worksAt; sublabel filters on a quantified edge are not supported
