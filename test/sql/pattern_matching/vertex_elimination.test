# name: test/sql/pattern_matching/vertex_elimination.test
# description: Vertex-join elimination: vertex tables that are only joined for their key are left out of the translation
# group: [pattern_matching]

require duckpgq

# The SQL/PGQ grammar is connection-local and must be activated explicitly.
statement ok
SET active_grammar_extensions = ['duckpgq'];

# Vertex tables with a unique key ...
statement ok
CREATE TABLE Person(id BIGINT PRIMARY KEY, name VARCHAR);

statement ok
CREATE TABLE Tag(id BIGINT PRIMARY KEY, name VARCHAR);

statement ok
CREATE TABLE Category(id BIGINT PRIMARY KEY, name VARCHAR);

# A second table whose ids overlap with Person
statement ok
CREATE TABLE Firm(id BIGINT PRIMARY KEY, name VARCHAR);

statement ok
CREATE TABLE Organisation(id BIGINT PRIMARY KEY, name VARCHAR, mask BIGINT);

statement ok
CREATE TABLE Flight(carrier VARCHAR, number INTEGER, PRIMARY KEY (carrier, number));

# ... and one without
statement ok
CREATE TABLE Forum(id BIGINT, title VARCHAR);

statement ok
CREATE TABLE knows(src BIGINT NOT NULL, dst BIGINT NOT NULL);

# tagId is nullable
statement ok
CREATE TABLE hasInterest(personId BIGINT NOT NULL, tagId BIGINT);

statement ok
CREATE TABLE hasCategory(tagId BIGINT NOT NULL, categoryId BIGINT NOT NULL);

statement ok
CREATE TABLE hasModerator(forumId BIGINT, personId BIGINT);

statement ok
CREATE TABLE worksAt(personId BIGINT, organisationId BIGINT);

statement ok
CREATE TABLE books(personId BIGINT, carrier VARCHAR, number INTEGER);

statement ok
INSERT INTO Person VALUES (1, 'Alice'), (2, 'Bob'), (3, 'Carol');

statement ok
INSERT INTO Tag VALUES (10, 't1'), (11, 't2');

statement ok
INSERT INTO Category VALUES (100, 'Athlete'), (101, 'Artist');

statement ok
INSERT INTO Firm VALUES (2, 'CWI');

statement ok
INSERT INTO Organisation VALUES (200, 'VU', 1), (201, 'CWI', 2);

statement ok
INSERT INTO Flight VALUES ('KL', 1), ('KL', 2), ('LH', 1);

statement ok
INSERT INTO Forum VALUES (1000, 'f1');

statement ok
INSERT INTO knows VALUES (1, 2), (2, 3), (3, 1), (1, 3);

statement ok
INSERT INTO hasInterest VALUES (1, 10), (2, 10), (3, 11), (1, NULL);

statement ok
INSERT INTO hasCategory VALUES (10, 100), (11, 101);

statement ok
INSERT INTO hasModerator VALUES (1000, 1);

statement ok
INSERT INTO worksAt VALUES (1, 200), (2, 201), (3, 201);

statement ok
INSERT INTO books VALUES (1, 'KL', 1), (2, 'KL', 1), (3, 'LH', 1);

statement ok
CREATE PROPERTY GRAPH g
VERTEX TABLES (
    Person LABEL Person,
    Tag LABEL Tag,
    Category LABEL Category,
    Firm LABEL Firm,
    Organisation LABEL Organisation IN mask(university, company),
    Flight LABEL Flight,
    Forum LABEL Forum
    )
EDGE TABLES (
    knows           SOURCE KEY (src) REFERENCES Person (id)
                    DESTINATION KEY (dst) REFERENCES Person (id)
                    LABEL knows,
    hasInterest     SOURCE KEY (personId) REFERENCES Person (id)
                    DESTINATION KEY (tagId) REFERENCES Tag (id)
                    LABEL hasInterest,
    hasCategory     SOURCE KEY (tagId) REFERENCES Tag (id)
                    DESTINATION KEY (categoryId) REFERENCES Category (id)
                    LABEL hasCategory,
    hasModerator    SOURCE KEY (forumId) REFERENCES Forum (id)
                    DESTINATION KEY (personId) REFERENCES Person (id)
                    LABEL hasModerator,
    worksAt         SOURCE KEY (personId) REFERENCES Person (id)
                    DESTINATION KEY (organisationId) REFERENCES Organisation (id)
                    LABEL worksAt,
    books           SOURCE KEY (personId) REFERENCES Person (id)
                    DESTINATION KEY (carrier, number) REFERENCES Flight (carrier, number)
                    LABEL books
    );

# ---------------------------------------------------------------------------------------------------------------------
# A 2-hop chain: Person and Tag are only used for their key, Category is filtered on a property
# ---------------------------------------------------------------------------------------------------------------------

query II
EXPLAIN SELECT * FROM GRAPH_TABLE (g
    MATCH (p:Person)-[hi:hasInterest]->(t:Tag)-[hc:hasCategory]->(c:Category)
    WHERE c.name = 'Athlete'
    COLUMNS (p.id, t.id AS tagId));
----
physical_plan	<!REGEX>:.*main\.(Person|Tag).*

query II
EXPLAIN SELECT * FROM GRAPH_TABLE (g
    MATCH (p:Person)-[hi:hasInterest]->(t:Tag)-[hc:hasCategory]->(c:Category)
    WHERE c.name = 'Athlete'
    COLUMNS (p.id, t.id AS tagId));
----
physical_plan	<REGEX>:.*main\.Category.*

query II
SELECT * FROM GRAPH_TABLE (g
    MATCH (p:Person)-[hi:hasInterest]->(t:Tag)-[hc:hasCategory]->(c:Category)
    WHERE c.name = 'Athlete'
    COLUMNS (p.id, t.id AS tagId))
ORDER BY ALL;
----
1	10
2	10

# Output column names and types are unchanged
query II
SELECT id, tagId FROM GRAPH_TABLE (g
    MATCH (p:Person)-[hi:hasInterest]->(t:Tag)-[hc:hasCategory]->(c:Category)
    WHERE c.name = 'Athlete'
    COLUMNS (p.id, t.id AS tagId))
ORDER BY ALL;
----
1	10
2	10

query II
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM GRAPH_TABLE (g
    MATCH (p:Person)-[hi:hasInterest]->(t:Tag)-[hc:hasCategory]->(c:Category)
    COLUMNS (p.id, t.id AS tagId, hi.personId)));
----
id	BIGINT
tagId	BIGINT
personId	BIGINT

# The result column is named as the catalog spells it, like the binder names a column reference without an alias
# or with an alias that only differs in case. (DuckDB applies the same rule to the edge column: an alias that
# differs only in case from the edge column's name, here tagId, is still spelled like that column.)
query II
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM GRAPH_TABLE (g
    MATCH (p:Person)-[hi:hasInterest]->(t:Tag)
    COLUMNS (p.ID, t.id AS TheTag)));
----
id	BIGINT
TheTag	BIGINT

query II
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM GRAPH_TABLE (g
    MATCH (p:Person)-[hi:hasInterest]->(t:Tag)
    COLUMNS (t.Id AS ID)));
----
id	BIGINT

statement ok
SET duckpgq_vertex_join_elimination = false;

query II
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM GRAPH_TABLE (g
    MATCH (p:Person)-[hi:hasInterest]->(t:Tag)
    COLUMNS (p.ID, t.id AS TheTag)));
----
id	BIGINT
TheTag	BIGINT

query II
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM GRAPH_TABLE (g
    MATCH (p:Person)-[hi:hasInterest]->(t:Tag)
    COLUMNS (t.Id AS ID)));
----
id	BIGINT

statement ok
SET duckpgq_vertex_join_elimination = true;

# Key references inside expressions are rewritten as well
query II
SELECT * FROM GRAPH_TABLE (g
    MATCH (p:Person)-[hi:hasInterest]->(t:Tag)-[hc:hasCategory]->(c:Category)
    WHERE p.id + t.id > 11
    COLUMNS (p.id * 2 AS doubled, c.name))
ORDER BY ALL;
----
4	Athlete
6	Artist

# The same query with the optimization disabled produces the same result
statement ok
SET duckpgq_vertex_join_elimination = false;

query II
EXPLAIN SELECT * FROM GRAPH_TABLE (g
    MATCH (p:Person)-[hi:hasInterest]->(t:Tag)-[hc:hasCategory]->(c:Category)
    WHERE c.name = 'Athlete'
    COLUMNS (p.id, t.id AS tagId));
----
physical_plan	<REGEX>:.*main\.Person.*

query II
EXPLAIN SELECT * FROM GRAPH_TABLE (g
    MATCH (p:Person)-[hi:hasInterest]->(t:Tag)-[hc:hasCategory]->(c:Category)
    WHERE c.name = 'Athlete'
    COLUMNS (p.id, t.id AS tagId));
----
physical_plan	<REGEX>:.*main\.Tag.*

query II
SELECT id, tagId FROM GRAPH_TABLE (g
    MATCH (p:Person)-[hi:hasInterest]->(t:Tag)-[hc:hasCategory]->(c:Category)
    WHERE c.name = 'Athlete'
    COLUMNS (p.id, t.id AS tagId))
ORDER BY ALL;
----
1	10
2	10

query II
SELECT * FROM GRAPH_TABLE (g
    MATCH (p:Person)-[hi:hasInterest]->(t:Tag)-[hc:hasCategory]->(c:Category)
    WHERE p.id + t.id > 11
    COLUMNS (p.id * 2 AS doubled, c.name))
ORDER BY ALL;
----
4	Athlete
6	Artist

statement ok
SET duckpgq_vertex_join_elimination = true;

# ---------------------------------------------------------------------------------------------------------------------
# Not eliminated: a non-key property is referenced
# ---------------------------------------------------------------------------------------------------------------------

query II
EXPLAIN SELECT * FROM GRAPH_TABLE (g
    MATCH (p:Person)-[hi:hasInterest]->(t:Tag)
    WHERE t.name = 't1'
    COLUMNS (p.id));
----
physical_plan	<REGEX>:.*main\.Tag.*

query II
EXPLAIN SELECT * FROM GRAPH_TABLE (g
    MATCH (p:Person)-[hi:hasInterest]->(t:Tag)
    WHERE t.name = 't1'
    COLUMNS (p.id));
----
physical_plan	<!REGEX>:.*main\.Person.*

query I
SELECT * FROM GRAPH_TABLE (g
    MATCH (p:Person)-[hi:hasInterest]->(t:Tag)
    WHERE t.name = 't1'
    COLUMNS (p.id))
ORDER BY ALL;
----
1
2

# An element-local WHERE counts as well
query II
EXPLAIN SELECT * FROM GRAPH_TABLE (g
    MATCH (p:Person WHERE p.name = 'Alice')-[hi:hasInterest]->(t:Tag)
    COLUMNS (t.id));
----
physical_plan	<REGEX>:.*main\.Person.*

# Not eliminated: references inside a lambda or a subquery are not classified, because an alias there could shadow
# the vertex variable (DuckDB currently resolves the qualified p.id below to the Person table, not the parameter)
query II
EXPLAIN SELECT * FROM GRAPH_TABLE (g
    MATCH (p:Person)-[hi:hasInterest]->(t:Tag)
    COLUMNS (t.id, list_transform([{'id': 42}], lambda p: p.id) AS shadowed));
----
physical_plan	<REGEX>:.*main\.Person.*

query II
SELECT DISTINCT * FROM GRAPH_TABLE (g
    MATCH (p:Person)-[hi:hasInterest]->(t:Tag)
    COLUMNS (t.id, list_transform([{'id': 42}], lambda p: p.id) AS shadowed))
ORDER BY ALL;
----
10	[1]
10	[2]
11	[3]

query II
EXPLAIN SELECT * FROM GRAPH_TABLE (g
    MATCH (p:Person)-[hi:hasInterest]->(t:Tag)
    WHERE t.id IN (SELECT p.id FROM (VALUES (10)) p(id))
    COLUMNS (t.id, p.id AS personId));
----
physical_plan	<REGEX>:.*main\.Person.*

# Not eliminated: v.* and COLUMNS (*)
query II
EXPLAIN SELECT * FROM GRAPH_TABLE (g
    MATCH (p:Person)-[hi:hasInterest]->(t:Tag)
    COLUMNS (t.*));
----
physical_plan	<REGEX>:.*main\.Tag.*

query II
EXPLAIN SELECT * FROM GRAPH_TABLE (g
    MATCH (p:Person)-[hi:hasInterest]->(t:Tag)
    COLUMNS (*));
----
physical_plan	<REGEX>:.*main\.Person.*main\.Tag.*|.*main\.Tag.*main\.Person.*

# Not eliminated: label inheritance adds a predicate on the discriminator column
query II
EXPLAIN SELECT * FROM GRAPH_TABLE (g
    MATCH (p:Person)-[w:worksAt]->(o:company)
    COLUMNS (p.id, o.id));
----
physical_plan	<REGEX>:.*main\.Organisation.*

query II
EXPLAIN SELECT * FROM GRAPH_TABLE (g
    MATCH (p:Person)-[w:worksAt]->(o:company)
    COLUMNS (p.id, o.id));
----
physical_plan	<!REGEX>:.*main\.Person.*

query II
SELECT * FROM GRAPH_TABLE (g
    MATCH (p:Person)-[w:worksAt]->(o:company)
    COLUMNS (p.id, o.id))
ORDER BY ALL;
----
2	201
3	201

# Not eliminated: path-finding endpoints
query II
EXPLAIN SELECT * FROM GRAPH_TABLE (g
    MATCH (a:Person)-[k:knows]->{1,3}(b:Person)
    COLUMNS (a.id, b.id));
----
physical_plan	<REGEX>:.*main\.Person.*

query II
SELECT * FROM GRAPH_TABLE (g
    MATCH (a:Person)-[k:knows]->{1,2}(b:Person)
    COLUMNS (a.id, b.id))
ORDER BY ALL;
----
1	2
1	3
2	1
2	3
3	1
3	2

# Not eliminated: a lone vertex pattern is a scan
query I
SELECT * FROM GRAPH_TABLE (g
    MATCH (p:Person)
    COLUMNS (p.id))
ORDER BY ALL;
----
1
2
3

# Not eliminated: the vertex key has no PRIMARY KEY or UNIQUE constraint
query II
EXPLAIN SELECT * FROM GRAPH_TABLE (g
    MATCH (f:Forum)-[m:hasModerator]->(p:Person)
    COLUMNS (f.id, p.id));
----
physical_plan	<REGEX>:.*main\.Forum.*

query II
EXPLAIN SELECT * FROM GRAPH_TABLE (g
    MATCH (f:Forum)-[m:hasModerator]->(p:Person)
    COLUMNS (f.id, p.id));
----
physical_plan	<!REGEX>:.*main\.Person.*

query II
SELECT * FROM GRAPH_TABLE (g
    MATCH (f:Forum)-[m:hasModerator]->(p:Person)
    COLUMNS (f.id, p.id));
----
1000	1

# ---------------------------------------------------------------------------------------------------------------------
# The same vertex variable in two patterns, cycles, undirected and bidirectional edges
# ---------------------------------------------------------------------------------------------------------------------

query II
EXPLAIN SELECT * FROM GRAPH_TABLE (g
    MATCH (a:Person)-[k:knows]->(b:Person), (a:Person)-[hi:hasInterest]->(t:Tag)
    COLUMNS (a.id, b.name, t.name));
----
physical_plan	<REGEX>:.*main\.Person.*

# ... but only one Person scan (for b) remains
query II
EXPLAIN SELECT * FROM GRAPH_TABLE (g
    MATCH (a:Person)-[k:knows]->(b:Person), (a:Person)-[hi:hasInterest]->(t:Tag)
    COLUMNS (a.id, b.name, t.name));
----
physical_plan	<!REGEX>:.*main\.Person.*main\.Person.*

query III
SELECT * FROM GRAPH_TABLE (g
    MATCH (a:Person)-[k:knows]->(b:Person), (a:Person)-[hi:hasInterest]->(t:Tag)
    COLUMNS (a.id, b.name, t.name))
ORDER BY ALL;
----
1	Bob	t1
1	Carol	t1
2	Carol	t1
3	Alice	t2

query II
EXPLAIN SELECT * FROM GRAPH_TABLE (g
    MATCH (a:Person)-[k1:knows]->(b:Person)-[k2:knows]->(a:Person)
    COLUMNS (a.id, b.id));
----
physical_plan	<!REGEX>:.*main\.Person.*

query II
SELECT * FROM GRAPH_TABLE (g
    MATCH (a:Person)-[k1:knows]->(b:Person)-[k2:knows]->(a:Person)
    COLUMNS (a.id, b.id))
ORDER BY ALL;
----
1	3
3	1

# Self loop on the same variable
query I
SELECT count(*) FROM GRAPH_TABLE (g
    MATCH (a:Person)-[k:knows]->(a:Person)
    COLUMNS (a.id));
----
0

query II
EXPLAIN SELECT * FROM GRAPH_TABLE (g
    MATCH (a:Person)-[k:knows]-(b:Person)
    COLUMNS (a.id, b.id));
----
physical_plan	<!REGEX>:.*main\.Person.*

query II
SELECT * FROM GRAPH_TABLE (g
    MATCH (a:Person)-[k:knows]-(b:Person)
    COLUMNS (a.id, b.id))
ORDER BY ALL;
----
1	2
1	3
1	3
2	1
2	3
3	1
3	1
3	2

query II
EXPLAIN SELECT * FROM GRAPH_TABLE (g
    MATCH (a:Person)<-[k:knows]->(b:Person)
    COLUMNS (a.id, b.id));
----
physical_plan	<!REGEX>:.*main\.Person.*

# Undirected and bidirectional edges accept any vertex label; when the vertex is not the table the edge references,
# the join is what filters, so it stays
query II
EXPLAIN SELECT * FROM GRAPH_TABLE (g
    MATCH (a:Person)-[k:knows]-(b:Firm)
    COLUMNS (a.id, b.id));
----
physical_plan	<REGEX>:.*main\.Firm.*

query II
SELECT * FROM GRAPH_TABLE (g
    MATCH (a:Person)-[k:knows]-(b:Firm)
    COLUMNS (a.id, b.id))
ORDER BY ALL;
----
1	2
3	2

query II
SELECT * FROM GRAPH_TABLE (g
    MATCH (a:Person)<-[k:knows]->(b:Person)
    COLUMNS (a.id, b.id))
ORDER BY ALL;
----
1	3
3	1

statement ok
SET duckpgq_vertex_join_elimination = false;

query III
SELECT * FROM GRAPH_TABLE (g
    MATCH (a:Person)-[k:knows]->(b:Person), (a:Person)-[hi:hasInterest]->(t:Tag)
    COLUMNS (a.id, b.name, t.name))
ORDER BY ALL;
