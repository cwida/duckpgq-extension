SET duckpgq_vertex_join_elimination = true;

# ---------------------------------------------------------------------------------------------------------------------
# Composite keys
# ---------------------------------------------------------------------------------------------------------------------

query II
EXPLAIN SELECT * FROM GRAPH_TABLE (g
    MATCH (p:Person)-[b:books]->(f:Flight)
    WHERE f.carrier = 'KL'
    COLUMNS (p.id, f.carrier, f.number));
----
physical_plan	<!REGEX>:.*main\.(Person|Flight).*

query III
SELECT * FROM GRAPH_TABLE (g
    MATCH (p:Person)-[b:books]->(f:Flight)
    WHERE f.carrier = 'KL'
    COLUMNS (p.id, f.carrier, f.number))
ORDER BY ALL;
----
1	KL	1
2	KL	1

# Two edges meet at the composite key: b2.carrier = b.carrier AND b2.number = b.number
query II
EXPLAIN SELECT * FROM GRAPH_TABLE (g
    MATCH (p:Person)-[b:books]->(f:Flight)<-[b2:books]-(p2:Person)
    WHERE p.id <> p2.id
    COLUMNS (p.id, p2.id AS other));
----
physical_plan	<!REGEX>:.*main\.(Person|Flight).*

query II
SELECT id, other FROM GRAPH_TABLE (g
    MATCH (p:Person)-[b:books]->(f:Flight)<-[b2:books]-(p2:Person)
    WHERE p.id <> p2.id
    COLUMNS (p.id, p2.id AS other))
ORDER BY ALL;
----
1	2
2	1

# ---------------------------------------------------------------------------------------------------------------------
# NULL keys and edges that no longer reference a vertex
# ---------------------------------------------------------------------------------------------------------------------

# A NULL edge key never matches a vertex: the IS NOT NULL guard keeps it out even without any other edge
query I
SELECT count(*) FROM GRAPH_TABLE (g
    MATCH (p:Person)-[hi:hasInterest]->(t:Tag)
    COLUMNS (t.id));
----
3

query I
SELECT count(*) FROM GRAPH_TABLE (g
    MATCH (p:Person)-[hi:hasInterest]->(t:Tag)
    COLUMNS (t.id)) WHERE id IS NULL;
----
0

# CREATE PROPERTY GRAPH verified that every edge key references a vertex (see test/sql/create_pg/incomplete_edges.test).
# Rows added afterwards are not checked: an edge that references no vertex survives when the vertex is eliminated,
# whereas the join dropped it. This is the documented limit of the optimization.
statement ok
INSERT INTO hasInterest VALUES (2, 99);

statement ok
INSERT INTO books VALUES (1, 'XX', 9);

query II
SELECT * FROM GRAPH_TABLE (g
    MATCH (p:Person)-[hi:hasInterest]->(t:Tag)
    COLUMNS (p.id, t.id AS tagId))
ORDER BY ALL;
----
1	10
2	10
2	99
3	11

query III
SELECT * FROM GRAPH_TABLE (g
    MATCH (p:Person)-[b:books]->(f:Flight)
    COLUMNS (p.id, f.carrier, f.number))
ORDER BY ALL;
----
1	KL	1
1	XX	9
2	KL	1
3	LH	1

# As soon as a property of the vertex is needed the join is back and the row is dropped again
query II
SELECT * FROM GRAPH_TABLE (g
    MATCH (p:Person)-[hi:hasInterest]->(t:Tag)
    WHERE t.name IS NOT NULL
    COLUMNS (p.id, t.id AS tagId))
ORDER BY ALL;
----
1	10
2	10
3	11

statement ok
SET duckpgq_vertex_join_elimination = false;

query II
SELECT * FROM GRAPH_TABLE (g
    MATCH (p:Person)-[hi:hasInterest]->(t:Tag)
    COLUMNS (p.id, t.id AS tagId))
ORDER BY ALL;
----
1	10
2	10
3	11

statement ok
SET duckpgq_vertex_join_elimination = true;

# Prepared statements bind the pattern again
statement ok
PREPARE q AS SELECT * FROM GRAPH_TABLE (g
    MATCH (p:Person)-[hi:hasInterest]->(t:Tag)-[hc:hasCategory]->(c:Category)
    WHERE c.name = ?
    COLUMNS (p.id, t.id AS tagId)) ORDER BY ALL;

query II
EXECUTE q('Athlete');
----
1	10
2	10

query II
EXECUTE q('Artist');
----
3	11
