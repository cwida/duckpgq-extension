# name: test/sql/cte/path_quantifier_union_all.test
# description: Path-quantified GRAPH_TABLE combined with UNION ALL (issue #304)
# group: [cte]

require duckpgq

statement ok
SET active_grammar_extensions = ['duckpgq']

statement ok
CREATE TABLE vertices (id VARCHAR PRIMARY KEY, name VARCHAR);

statement ok
INSERT INTO vertices VALUES ('a', 'A'), ('b', 'B'), ('c', 'C');

statement ok
CREATE TABLE edges (src VARCHAR, dst VARCHAR);

statement ok
INSERT INTO edges VALUES ('b', 'a'), ('c', 'b');

statement ok
CREATE PROPERTY GRAPH g
VERTEX TABLES ( vertices LABEL V )
EDGE TABLES (
    edges SOURCE KEY (src) REFERENCES vertices (id)
          DESTINATION KEY (dst) REFERENCES vertices (id)
          LABEL E
);

# The query from the issue
query II rowsort
WITH ancestors AS (
    SELECT * FROM (
        FROM GRAPH_TABLE(g
            MATCH (a:V)-[k:E]->{1,2}(b:V)
            COLUMNS(a.id AS child, b.id AS ancestor)
        )
    ) sub
)
SELECT child, ancestor FROM ancestors
UNION ALL
SELECT 'x' AS child, 'y' AS ancestor
----
b	a
c	a
c	b
x	y

# Without the CTE
query II rowsort
SELECT child, ancestor FROM GRAPH_TABLE(g
    MATCH (a:V)-[k:E]->{1,2}(b:V)
    COLUMNS(a.id AS child, b.id AS ancestor)
)
UNION ALL
SELECT 'x' AS child, 'y' AS ancestor
----
b	a
c	a
c	b
x	y

# The constant row first
query II rowsort
SELECT 'x' AS child, 'y' AS ancestor
UNION ALL
FROM GRAPH_TABLE(g
    MATCH (a:V)-[k:E]->{1,2}(b:V)
    COLUMNS(a.id AS child, b.id AS ancestor)
)
----
b	a
c	a
c	b
x	y

# A materialized CTE
query II rowsort
WITH ancestors AS MATERIALIZED (
    FROM GRAPH_TABLE(g
        MATCH (a:V)-[k:E]->{1,2}(b:V)
        COLUMNS(a.id AS child, b.id AS ancestor)
    )
)
SELECT child, ancestor FROM ancestors
UNION ALL
SELECT 'x' AS child, 'y' AS ancestor
----
b	a
c	a
c	b
x	y

# UNION (deduplicating) of the same quantified pattern twice
query II rowsort
FROM GRAPH_TABLE(g
    MATCH (a:V)-[k:E]->{1,2}(b:V)
    COLUMNS(a.id AS child, b.id AS ancestor)
)
UNION
FROM GRAPH_TABLE(g
    MATCH (a:V)-[k:E]->{1,2}(b:V)
    COLUMNS(a.id AS child, b.id AS ancestor)
)
----
b	a
c	a
c	b

# UNION ALL of two different quantified patterns
query II rowsort
FROM GRAPH_TABLE(g
    MATCH (a:V)-[k:E]->{1,1}(b:V)
    COLUMNS(a.id AS child, b.id AS ancestor)
)
UNION ALL
FROM GRAPH_TABLE(g
    MATCH (a:V)-[k:E]->{2,2}(b:V)
    COLUMNS(a.id AS child, b.id AS ancestor)
)
----
b	a
c	a
c	b

# Kleene star and plus, and a shortest path with path columns
query II rowsort
FROM GRAPH_TABLE(g
    MATCH ANY SHORTEST (a:V)-[k:E]->+(b:V)
    COLUMNS(a.id AS child, b.id AS ancestor)
)
UNION ALL
FROM GRAPH_TABLE(g
    MATCH ANY SHORTEST (a:V WHERE a.id = 'c')-[k:E]->*(b:V)
    COLUMNS(a.id AS child, b.id AS ancestor)
)
----
b	a
c	a
c	a
c	b
c	b
c	c

query III rowsort
FROM GRAPH_TABLE(g
    MATCH p = ANY SHORTEST (a:V)-[k:E]->{1,2}(b:V)
    COLUMNS(a.id AS child, b.id AS ancestor, path_length(p) AS len)
)
UNION ALL
SELECT 'x', 'y', 0
----
b	a	1
c	a	2
c	b	1
x	y	0

# A CTE with a quantified pattern referenced on both sides of a UNION ALL
query II rowsort
WITH ancestors AS (
    FROM GRAPH_TABLE(g
        MATCH (a:V)-[k:E]->{1,2}(b:V)
        COLUMNS(a.id AS child, b.id AS ancestor)
    )
)
SELECT child, ancestor FROM ancestors
UNION ALL
SELECT ancestor, child FROM ancestors
----
a	b
a	c
b	a
b	c
c	a
c	b

# Two quantified GRAPH_TABLEs joined in one query
query II rowsort
SELECT x.child, y.ancestor
FROM GRAPH_TABLE(g MATCH (a:V)-[k:E]->{1,2}(b:V) COLUMNS(a.id AS child, b.id AS ancestor)) x
JOIN GRAPH_TABLE(g MATCH (a:V)-[k:E]->{1,2}(b:V) COLUMNS(a.id AS child, b.id AS ancestor)) y
  ON x.ancestor = y.child
----
c	a

# The UNION ALL inside the CTE, aggregated outside
query I
WITH everything AS (
    FROM GRAPH_TABLE(g
        MATCH (a:V)-[k:E]->{1,2}(b:V)
        COLUMNS(a.id AS child, b.id AS ancestor)
    )
    UNION ALL
    SELECT 'x' AS child, 'y' AS ancestor
)
SELECT count(*) FROM everything
----
4

# Three quantified GRAPH_TABLEs joined in one query
query III rowsort
SELECT x.child, y.child, z.ancestor
FROM GRAPH_TABLE(g MATCH (a:V)-[k:E]->{1,1}(b:V) COLUMNS(a.id AS child, b.id AS ancestor)) x
JOIN GRAPH_TABLE(g MATCH (a:V)-[k:E]->{1,2}(b:V) COLUMNS(a.id AS child, b.id AS ancestor)) y
  ON x.ancestor = y.child
JOIN GRAPH_TABLE(g MATCH ANY SHORTEST (a:V)-[k:E]->*(b:V) COLUMNS(a.id AS child, b.id AS ancestor)) z
  ON y.ancestor = z.child
----
c	b	a

# Quantified GRAPH_TABLEs joined with each other and with a base table
query III rowsort
SELECT v.name, x.ancestor, y.ancestor
FROM vertices v
JOIN GRAPH_TABLE(g MATCH (a:V)-[k:E]->{1,2}(b:V) COLUMNS(a.id AS child, b.id AS ancestor)) x
  ON v.id = x.child
LEFT JOIN GRAPH_TABLE(g MATCH (a:V)-[k:E]->{1,1}(b:V) COLUMNS(a.id AS child, b.id AS ancestor)) y
  ON x.ancestor = y.child
----
B	a	NULL
C	a	NULL
C	b	a

# A MATCH with two quantified edges joined with another quantified GRAPH_TABLE
query III rowsort
SELECT x.s, x.m, y.ancestor
FROM GRAPH_TABLE(g
    MATCH (s:V)-[k1:E]->{1,1}(m:V)-[k2:E]->{1,1}(t:V)
    COLUMNS(s.id AS s, m.id AS m, t.id AS t)) x
JOIN GRAPH_TABLE(g MATCH (a:V)-[k:E]->{1,2}(b:V) COLUMNS(a.id AS child, b.id AS ancestor)) y
  ON x.m = y.child
----
c	b	a

# Joins on both sides of a UNION ALL
query II rowsort
SELECT x.child, y.ancestor
FROM GRAPH_TABLE(g MATCH (a:V)-[k:E]->{1,1}(b:V) COLUMNS(a.id AS child, b.id AS ancestor)) x
JOIN GRAPH_TABLE(g MATCH (a:V)-[k:E]->{1,1}(b:V) COLUMNS(a.id AS child, b.id AS ancestor)) y
  ON x.ancestor = y.child
UNION ALL
SELECT x.child, y.child
FROM GRAPH_TABLE(g MATCH (a:V)-[k:E]->{1,2}(b:V) COLUMNS(a.id AS child, b.id AS ancestor)) x
JOIN GRAPH_TABLE(g MATCH (a:V)-[k:E]->{1,2}(b:V) COLUMNS(a.id AS child, b.id AS ancestor)) y
  ON x.ancestor = y.ancestor AND x.child <> y.child
----
b	c
c	a
c	b

# Several statements in a row: the CSR ids start over after every query and must not clash with the CSRs of
# earlier statements
statement ok
CREATE TABLE stored AS
FROM GRAPH_TABLE(g MATCH (a:V)-[k:E]->{1,2}(b:V) COLUMNS(a.id AS child, b.id AS ancestor))
UNION ALL
FROM GRAPH_TABLE(g MATCH (a:V)-[k:E]->{1,1}(b:V) COLUMNS(a.id AS child, b.id AS ancestor))

query II rowsort
SELECT child, ancestor FROM stored
----
b	a
b	a
c	a
c	b
c	b

statement ok
INSERT INTO stored
FROM GRAPH_TABLE(g MATCH (a:V)-[k:E]->{2,2}(b:V) COLUMNS(a.id AS child, b.id AS ancestor))
UNION ALL
SELECT 'x', 'y'

query II rowsort
SELECT s.child, x.ancestor
FROM stored s
JOIN GRAPH_TABLE(g MATCH (a:V)-[k:E]->{1,2}(b:V) COLUMNS(a.id AS child, b.id AS ancestor)) x
  ON s.ancestor = x.child
----
c	a
c	a

statement ok
CREATE VIEW ancestors_view AS
FROM GRAPH_TABLE(g MATCH (a:V)-[k:E]->{1,2}(b:V) COLUMNS(a.id AS child, b.id AS ancestor))

query II rowsort
SELECT v.child, x.ancestor
FROM ancestors_view v
JOIN GRAPH_TABLE(g MATCH (a:V)-[k:E]->{1,1}(b:V) COLUMNS(a.id AS child, b.id AS ancestor)) x
  ON v.ancestor = x.child
UNION ALL
SELECT child, ancestor FROM ancestors_view
----
b	a
c	a
c	a
c	b

# A prepared statement with two quantified GRAPH_TABLEs, executed several times between other queries
statement ok
PREPARE two_paths AS
FROM GRAPH_TABLE(g MATCH (a:V)-[k:E]->{1,2}(b:V) COLUMNS(a.id AS child, b.id AS ancestor))
UNION ALL
FROM GRAPH_TABLE(g MATCH (a:V)-[k:E]->{1,1}(b:V) COLUMNS(a.id AS child, b.id AS ancestor))

query II rowsort
EXECUTE two_paths
----
b	a
b	a
c	a
c	b
c	b

query I
SELECT count(*) FROM GRAPH_TABLE(g MATCH (a:V)-[k:E]->{1,2}(b:V) COLUMNS(a.id AS child))
----
3

query II rowsort
EXECUTE two_paths
----
b	a
b	a
c	a
c	b
c	b

# The edge table changes between statements
statement ok
INSERT INTO edges VALUES ('a', 'c')

query II rowsort
FROM GRAPH_TABLE(g MATCH (a:V)-[k:E]->{1,1}(b:V) COLUMNS(a.id AS child, b.id AS ancestor))
UNION ALL
FROM GRAPH_TABLE(g MATCH (a:V)-[k:E]->{2,2}(b:V) COLUMNS(a.id AS child, b.id AS ancestor))
----
a	b
a	c
b	a
b	c
c	a
c	b
