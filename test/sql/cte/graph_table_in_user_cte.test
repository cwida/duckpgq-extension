# name: test/sql/cte/graph_table_in_user_cte.test
# description: GRAPH_TABLE inside a user-defined CTE (issue #319)
# group: [cte]

require duckpgq

statement ok
SET active_grammar_extensions = ['duckpgq']

statement ok
CREATE TABLE particle (particle_uid BIGINT PRIMARY KEY, name VARCHAR);

statement ok
CREATE TABLE vertex (vertex_uid BIGINT PRIMARY KEY, name VARCHAR);

statement ok
CREATE TABLE e_outgoing (vertex_uid BIGINT, particle_uid BIGINT);

statement ok
INSERT INTO particle VALUES (101, 'a'), (102, 'b'), (103, 'c');

statement ok
INSERT INTO vertex VALUES (10, 'primary');

statement ok
INSERT INTO e_outgoing VALUES (10, 101), (10, 102), (10, 103);

statement ok
CREATE PROPERTY GRAPH hep_demo_plain
VERTEX TABLES (
    particle LABEL Particle,
    vertex   LABEL Vtx
)
EDGE TABLES (
    e_outgoing
        SOURCE KEY (vertex_uid) REFERENCES vertex (vertex_uid)
        DESTINATION KEY (particle_uid) REFERENCES particle (particle_uid)
        LABEL outgoing
);

# Reproducer from the issue
query II rowsort
WITH topo AS (
    SELECT *
    FROM GRAPH_TABLE (hep_demo_plain
        MATCH (v:Vtx)-[e:outgoing]->(p:Particle)
        COLUMNS (v.vertex_uid AS vertex_uid, p.particle_uid AS particle_uid)
    )
)
SELECT * FROM topo;
----
10	101
10	102
10	103

# Aggregation over the CTE
query II
WITH topo AS (
    SELECT *
    FROM GRAPH_TABLE (hep_demo_plain
        MATCH (v:Vtx)-[e:outgoing]->(p:Particle)
        COLUMNS (v.vertex_uid AS vertex_uid, p.particle_uid AS particle_uid)
    )
)
SELECT vertex_uid, count(*) FROM topo GROUP BY vertex_uid;
----
10	3

# Materialized CTE
query II rowsort
WITH topo AS MATERIALIZED (
    SELECT *
    FROM GRAPH_TABLE (hep_demo_plain
        MATCH (v:Vtx)-[e:outgoing]->(p:Particle)
        COLUMNS (v.vertex_uid AS vertex_uid, p.particle_uid AS particle_uid)
    )
)
SELECT * FROM topo;
----
10	101
10	102
10	103

# CTE referenced twice, joined with a base table
query III rowsort
WITH topo AS (
    SELECT *
    FROM GRAPH_TABLE (hep_demo_plain
        MATCH (v:Vtx)-[e:outgoing]->(p:Particle)
        COLUMNS (v.vertex_uid AS vertex_uid, p.particle_uid AS particle_uid)
    )
)
SELECT t1.particle_uid, t2.particle_uid, particle.name
FROM topo t1 JOIN topo t2 ON t1.particle_uid = t2.particle_uid
JOIN particle ON particle.particle_uid = t1.particle_uid;
----
101	101	a
102	102	b
103	103	c

# Two CTEs, the second one using GRAPH_TABLE, combined with UNION ALL
query I rowsort
WITH a AS (SELECT 1 AS x),
topo AS (
    SELECT *
    FROM GRAPH_TABLE (hep_demo_plain
        MATCH (v:Vtx)-[e:outgoing]->(p:Particle)
        COLUMNS (p.particle_uid AS particle_uid)
    )
)
SELECT x FROM a UNION ALL SELECT particle_uid FROM topo;
----
1
101
102
103

# Nested WITH inside the CTE body
query I rowsort
WITH outer_cte AS (
    WITH inner_cte AS (
        SELECT *
        FROM GRAPH_TABLE (hep_demo_plain
            MATCH (v:Vtx)-[e:outgoing]->(p:Particle)
            COLUMNS (p.name AS name)
        )
    )
    SELECT name FROM inner_cte
)
SELECT name FROM outer_cte;
----
a
b
c

# Shortest path inside a CTE (the rewrite adds its own CTEs next to the user's)
statement ok
CREATE TABLE decay (src BIGINT, dst BIGINT);

statement ok
INSERT INTO decay VALUES (101, 102), (102, 103);

statement ok
CREATE PROPERTY GRAPH decay_graph
VERTEX TABLES (particle)
EDGE TABLES (
    decay SOURCE KEY (src) REFERENCES particle (particle_uid)
          DESTINATION KEY (dst) REFERENCES particle (particle_uid)
);

query III rowsort
WITH paths AS (
    SELECT *
    FROM GRAPH_TABLE (decay_graph
        MATCH p = ANY SHORTEST (a:particle WHERE a.particle_uid = 101)-[d:decay]->{1,3}(b:particle)
        COLUMNS (a.particle_uid AS src, b.particle_uid AS dst, path_length(p) AS len)
    )
)
SELECT * FROM paths;
----
101	102	1
101	103	2

# CTE with GRAPH_TABLE used inside a scalar subquery of the outer query
query I
WITH topo AS (
    SELECT *
    FROM GRAPH_TABLE (hep_demo_plain
        MATCH (v:Vtx)-[e:outgoing]->(p:Particle)
        COLUMNS (p.particle_uid AS particle_uid)
    )
)
SELECT (SELECT count(*) FROM topo);
----
3
